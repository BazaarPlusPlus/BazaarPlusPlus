# Store and check out text as LF across every project.
* text=auto eol=lf

# Windows batch scripts need CRLF.
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets: never normalize, never diff.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.icns  binary
*.webp  binary
*.bmp   binary
*.zip   binary
*.gz    binary
*.7z    binary
*.nupkg binary
*.dll   binary
*.exe   binary
*.so    binary
*.dylib binary
*.lib   binary
*.pdb   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
*.wasm  binary
