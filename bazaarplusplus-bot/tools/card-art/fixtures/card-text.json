    "b9f24e83531326204197015b2f43a93f": "伤害",
    "c92a86ef9dceabc5bf5ec6eb9bfd1318": "弹药",
    "d1ec8061bd5ae4001d20acee9372c056": "刺刀手枪",
    "d4939fda6b04a871dc63c652bbef33ad": "暴击率",
