{
  "name": "bppinstaller",
  "version": "6.3.0",
  "description": "BazaarPlusPlus Desktop App",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "generate:bindings": "bun scripts/generate-bindings.ts",
    "generate:bindings:test": "bun scripts/generate-bindings.ts --with-rust-tests",
    "generate:bindings:if-stale": "bun scripts/generate-bindings.ts --if-stale",
    "dev": "bun run generate:bindings:if-stale && vp dev",
    "check:bindings": "bun scripts/checks/prebuild-check.ts --bindings-only",
    "prebuild-check": "bun run generate:bindings && bun run prebuild-check:after-bindings",
    "prebuild-check:after-bindings": "bun scripts/checks/prebuild-check.ts",
    "prebuild-check:source:after-bindings": "bun scripts/checks/prebuild-check.ts --source-only",
    "build": "bun run generate:bindings && bun run build:after-bindings",
    "build:after-bindings": "bun run prebuild-check:after-bindings && bun run check:ts && bun run build:frontend",
    "build:frontend": "vp build",
    "test": "bun run generate:bindings:test && bun run check:bindings && bun run test:unit",
    "test:unit": "vp test run",
    "format": "vp fmt --write",
    "format:check": "vp fmt --check",
    "lint": "vp lint --type-aware",
    "lint:fix": "vp lint --type-aware --fix",
    "check:ts": "tsc --noEmit && tsc -p scripts",
    "verify": "bun scripts/checks/verify.ts",
    "docs:check": "bun scripts/checks/docs-check.ts",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0"
  }
}
