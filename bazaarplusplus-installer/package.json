{
  "name": "bppinstaller",
  "version": "6.4.5",
  "description": "BazaarPlusPlus Desktop App",
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "generate:bindings": "bun scripts/generate-bindings.ts",
    "generate:bindings:if-stale": "bun scripts/generate-bindings.ts --if-stale",
    "dev": "bun run generate:bindings:if-stale && vp dev",
    "prebuild-check": "bun run generate:bindings && bun scripts/checks/prebuild-check.ts",
    "build": "bun run generate:bindings && bun scripts/checks/prebuild-check.ts && bun run typecheck && bun run build:frontend",
    "build:frontend": "vp build",
    "test": "bun scripts/generate-bindings.ts --with-rust-tests && bun scripts/checks/prebuild-check.ts --bindings-only && bun run test:unit",
    "test:unit": "vp test run",
    "format": "vp fmt --write .",
    "format:check": "vp fmt --check .",
    "lint": "vp lint --type-aware",
    "lint:fix": "vp lint --type-aware --fix",
    "typecheck": "tsc --noEmit && tsc -p scripts",
    "verify": "bun scripts/checks/verify.ts",
    "docs:check": "bun scripts/checks/docs-check.ts",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@bazaarplusplus/ui": "workspace:*",
    "@bpp/runs": "workspace:*",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.75.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@tauri-apps/cli": "^2.12.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "vite-plus": "1.7.0"
  }
}
