{
  "name": "bppinstaller",
  "version": "5.2.1",
  "description": "BazaarPlusPlus Desktop App",
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": ">=10 <12"
  },
  "scripts": {
    "generate:bindings": "node scripts/generate-bindings.mjs",
    "generate:bindings:test": "node scripts/generate-bindings.mjs --with-rust-tests",
    "dev": "npm run generate:bindings && vite dev",
    "version:sync": "node scripts/release/version-sync.mjs",
    "prepare:resources": "node scripts/release/payload-zip.mjs",
    "verify:native-recorder-input": "node scripts/release/native-recorder-input.mjs",
    "prepare:ci-resources": "node scripts/ci-resource-fixture.mjs",
    "check:bindings": "node scripts/checks/prebuild-check.mjs --bindings-only",
    "prebuild-check": "npm run generate:bindings && npm run prebuild-check:after-bindings",
    "prebuild-check:after-bindings": "node scripts/checks/prebuild-check.mjs",
    "prebuild-check:source:after-bindings": "node scripts/checks/prebuild-check.mjs --source-only",
    "build": "npm run generate:bindings && npm run build:after-bindings",
    "build:after-bindings": "npm run prebuild-check:after-bindings && npm run check:ts && npm run build:frontend",
    "build:frontend": "vite build",
    "preview": "vite preview",
    "test": "npm run generate:bindings:test && npm run check:bindings && npm run test:unit",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"*.json\" \"src/**/*.{ts,tsx,html}\" \"scripts/**/*.mjs\" \"src-tauri/*.json\" \"src-tauri/capabilities/**/*.json\" \"vite.config.ts\"",
    "format:check": "prettier --check \"*.json\" \"src/**/*.{ts,tsx,html}\" \"scripts/**/*.mjs\" \"src-tauri/*.json\" \"src-tauri/capabilities/**/*.json\" \"vite.config.ts\"",
    "check": "npm run generate:bindings && npm run check:ts",
    "check:ts": "tsc --noEmit",
    "check:watch": "npm run generate:bindings && tsc --noEmit --watch",
    "verify": "node scripts/checks/verify.mjs",
    "docs:check": "node scripts/checks/docs-check.mjs",
    "tauri": "tauri"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.4",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10",
    "wrangler": "4.123.0"
  }
}
