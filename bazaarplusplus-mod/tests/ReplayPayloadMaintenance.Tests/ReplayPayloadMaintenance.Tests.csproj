<Project Sdk="Microsoft.NET.Sdk">
  <!-- Replay payload and video maintenance over the desktop host's replay stores and the
       history database; the host reference carries the game assemblies those stores bind. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>ReplayPayloadMaintenance.Tests</AssemblyName>
    <!-- The checks hold maintenance and playback threads at gates and assert on bounded blocking
         waits (a task that must not finish within 100 ms, a gate that must open within 5 s), as
         the capsule did. -->
    <NoWarn>$(NoWarn);xUnit1031</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BazaarPlusPlus/BazaarPlusPlus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="../BundleQueueSqliteStore.Tests/BundleSealEligibilityCases.cs"
      Link="BundleSealEligibilityCases.cs"
    />
    <None
      Include="../BundleQueueSqliteStore.Tests/fixtures/bundle-seal-eligibility.json"
      Link="fixtures/bundle-seal-eligibility.json"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
