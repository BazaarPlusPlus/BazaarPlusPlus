<Project Sdk="Microsoft.NET.Sdk">
  <!-- Replay payload and video maintenance over the desktop host's replay stores and the
       history database; the host reference carries the game assemblies those stores bind. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BazaarPlusPlus/BazaarPlusPlus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="../BundleQueueSqliteStore.Tests/BundleSealEligibilityCases.cs"
      Link="BundleSealEligibilityCases.cs"
    />
    <None
      Include="../BundleQueueSqliteStore.Tests/fixtures/bundle-seal-eligibility.json"
      Link="fixtures/bundle-seal-eligibility.json"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
