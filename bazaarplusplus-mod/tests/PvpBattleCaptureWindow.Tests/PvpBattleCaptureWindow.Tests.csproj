<Project Sdk="Microsoft.NET.Sdk">
  <!-- The PvP Battle Capture Window (ADR-0021) through its public interface, over a scripted
       battle-reading port and real Core collaborators. Needs no game snapshot, so `mod::test` and
       `mod::test-core` both run it. Each host's reads are checked in its own lane. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <BppRequiresManagedPath>false</BppRequiresManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Named explicitly so the test tree's netstandard2.1 pin leaves Core and its references on
       net10.0; the Mono targets need the Managed snapshot `mod::test-core` does not fetch. -->
  <ItemGroup>
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Core/BazaarPlusPlus.Core.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Storage/BazaarPlusPlus.Storage.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <ProjectReference
      Include="../../src/BazaarPlusPlus.ModApi/BazaarPlusPlus.ModApi.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <!-- The shared projects keep their serializers private; the catalog round trip needs them. -->
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>
</Project>
