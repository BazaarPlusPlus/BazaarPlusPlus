<Project Sdk="Microsoft.NET.Sdk">
  <!-- The CoreCLR host's configuration of BundleV6Codec.Tests: the same sources against the net10.0
       output, bound to the NuGet packages pinned to the game's versions instead of the game's
       Managed copies (ADR-0013). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile
      Include="../BundleV6Codec.Tests/**/*.cs"
      Exclude="../BundleV6Codec.Tests/obj/**;../BundleV6Codec.Tests/bin/**"
      Link="%(RecursiveDir)%(Filename)%(Extension)"
    />
  </ItemGroup>

  <!-- The shared project keeps its package references private, so this host supplies them. -->
  <ItemGroup>
    <ProjectReference
      Include="../../src/BazaarPlusPlus.ModApi/BazaarPlusPlus.ModApi.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="../BundleV6Codec.Tests/fixtures/run-payload-v6.fixture.b64"
      Link="fixtures/run-payload-v6.fixture.b64"
      CopyToOutputDirectory="PreserveNewest"
    />
    <None
      Include="../../../bazaarplusplus-server/contracts/v6/fixtures/*"
      Link="fixtures/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
