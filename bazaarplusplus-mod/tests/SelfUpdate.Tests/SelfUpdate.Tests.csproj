<Project Sdk="Microsoft.NET.Sdk">
  <!-- Core's self-update staging and decision, compiled from source together with the Updater
       that consumes what staging writes: one download goes all the way to a swapped install.
       Needs no game snapshot, so `mod::test` and `mod::test-core` both run it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>SelfUpdate.Tests</AssemblyName>
    <BppRequiresManagedPath>false</BppRequiresManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="../../src/BazaarPlusPlus.Core/Infrastructure/SelfUpdate/*.cs"
      Link="Core/SelfUpdate/%(Filename)%(Extension)"
    />
    <Compile
      Include="../../src/BazaarPlusPlus.Updater/Shared/*.cs"
      Link="Updater/Shared/%(Filename)%(Extension)"
    />
    <Compile
      Include="../../src/BazaarPlusPlus.Updater/ManagedPayloadSwap.cs"
      Link="Updater/ManagedPayloadSwap.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus.Updater/UpdaterLog.cs"
      Link="Updater/UpdaterLog.cs"
    />
    <Compile Include="../Updater.Tests/TestSigner.cs" Link="TestSigner.cs" />
  </ItemGroup>
</Project>
