<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <ProjectRoot>$(MSBuildThisFileDirectory)../../</ProjectRoot>
  </PropertyGroup>

  <ItemGroup>
    <Compile
      Include="..\..\src\BazaarPlusPlus\Core\GameState\ChoiceScreenPedestalKind.cs"
      Link="ChoiceScreenPedestalKind.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\GameInterop\Encounter\ChoiceScreenPedestalResolver.cs"
      Link="ChoiceScreenPedestalResolver.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\GameInterop\Encounter\PedestalEnchantCatalog.cs"
      Link="PedestalEnchantCatalog.cs"
    />
    <Reference Include="BazaarGameShared">
      <HintPath>$(ManagedPath)/BazaarGameShared.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
