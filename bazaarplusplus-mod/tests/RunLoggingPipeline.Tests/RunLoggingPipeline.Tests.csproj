<Project Sdk="Microsoft.NET.Sdk">
  <!-- The desktop host's configuration of the Run Logging anchor: the netstandard2.1 outputs of
       Core and Storage, bound to the game's libraries. RunLoggingPipeline.Net10.Tests runs the
       same sources against the net10.0 outputs (ADR-0013). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>RunLoggingPipeline.Tests</AssemblyName>
    <BppReferenceGameLibraries>true</BppReferenceGameLibraries>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Core/BazaarPlusPlus.Core.csproj"
      SetTargetFramework="TargetFramework=netstandard2.1"
    />
    <Compile Include="../Shared/SharedTargetPin.cs" Link="SharedTargetPin.cs" />
  </ItemGroup>
</Project>
