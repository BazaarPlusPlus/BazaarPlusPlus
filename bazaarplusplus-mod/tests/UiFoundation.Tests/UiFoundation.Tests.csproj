<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>UiFoundation.Tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/Fonts/UnicodeFontCoverage.cs"
      Link="UnicodeFontCoverage.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/Fonts/NativeGameFontSelection.cs"
      Link="NativeGameFontSelection.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Infrastructure/StablePanelText.cs"
      Link="StablePanelText.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/BilingualItemNames/BilingualItemNamePresentation.cs"
      Link="BilingualItemNamePresentation.cs"
    />
    <Compile Include="../../src/BazaarPlusPlus/Infrastructure/UiTokens/Sizes.cs" Link="Sizes.cs" />
    <Compile
      Include="../../src/BazaarPlusPlus/Infrastructure/UiTokens/BppOverlaySorting.cs"
      Link="BppOverlaySorting.cs"
    />
    <Compile Include="UiFoundationTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BazaarPlusPlus.Core/BazaarPlusPlus.Core.csproj" />
  </ItemGroup>
</Project>
