<Project Sdk="Microsoft.NET.Sdk">
  <!-- The CoreCLR host's configuration of ModApi.Tests: the same sources against the net10.0
       output, bound to the NuGet packages pinned to the game's versions instead of the game's
       Managed copies (ADR-0013). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile
      Include="../ModApi.Tests/**/*.cs"
      Exclude="../ModApi.Tests/obj/**;../ModApi.Tests/bin/**"
      Link="%(RecursiveDir)%(Filename)%(Extension)"
    />
  </ItemGroup>

  <!-- The shared project keeps its package references private, so this host supplies them. -->
  <ItemGroup>
    <ProjectReference
      Include="../../src/BazaarPlusPlus.ModApi/BazaarPlusPlus.ModApi.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="../../../bazaarplusplus-server/contracts/mod-api-errors.json"
      LogicalName="ModApi.Tests.mod-api-errors.json"
    />
    <EmbeddedResource
      Include="../../../bazaarplusplus-server/contracts/v6/ghost-summary.response.json"
      LogicalName="ModApi.Tests.ghost-summary.response.json"
    />
  </ItemGroup>
</Project>
