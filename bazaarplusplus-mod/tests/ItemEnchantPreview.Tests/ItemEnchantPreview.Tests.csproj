<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <ProjectRoot>$(MSBuildThisFileDirectory)../../</ProjectRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BazaarPlusPlus/BazaarPlusPlus.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BazaarGameClient">
      <HintPath>$(ManagedPath)/BazaarGameClient.dll</HintPath>
    </Reference>
    <Reference Include="BazaarGameShared">
      <HintPath>$(ManagedPath)/BazaarGameShared.dll</HintPath>
    </Reference>
    <Reference Include="TheBazaarRuntime">
      <HintPath>$(ManagedPath)/TheBazaarRuntime.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
