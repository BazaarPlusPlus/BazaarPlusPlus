<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Combat Impact acceptance runner (ADR-0019): projects the BPP-owned Combat Impact Corpus
       through Core alone, so `mod::test-core` runs it without a Managed snapshot. The corpus
       format in Format/ is compiled here and by CombatImpact.CorpusExport, the host lane that
       writes it from game payloads. Storage and ModApi are Core's own references, named
       explicitly so the test tree's netstandard2.1 pin leaves them on net10.0 with Core. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BppRequiresManagedPath>false</BppRequiresManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Core/BazaarPlusPlus.Core.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Storage/BazaarPlusPlus.Storage.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <ProjectReference
      Include="../../src/BazaarPlusPlus.ModApi/BazaarPlusPlus.ModApi.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
  </ItemGroup>
</Project>
