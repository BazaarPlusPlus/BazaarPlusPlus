<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Combat Impact producer lives in Core on BPP combat facets (ADR-0019). This lane decodes
       game replay payloads and reads the game catalog, so it replays them offline through the
       compiled desktop host's DesktopCombatTimeline adapter via InternalsVisibleTo, linking no
       host source. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BppReferenceGameLibraries>true</BppReferenceGameLibraries>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BazaarPlusPlus/BazaarPlusPlus.csproj" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <Reference Include="BazaarGameShared">
      <HintPath>$(ManagedPath)/BazaarGameShared.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
