<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BazaarPlusPlus.ModApi/BazaarPlusPlus.ModApi.csproj" />
    <PackageReference Include="MessagePack" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <Reference Include="BazaarGameShared">
      <HintPath>$(ManagedPath)/BazaarGameShared.dll</HintPath>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(ManagedPath)/Newtonsoft.Json.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- The accounting engine and the runtime adapters it reads through, by directory rather than
         by file, so splitting or adding a source file stays an ordinary refactor. -->
    <Compile
      Include="../../src/BazaarPlusPlus/Game/PostCombatImpact/Data/*.cs"
      Link="Data/%(Filename)%(Extension)"
    />
    <!-- The engine files that bind Assembly-CSharp types. This lane replays payloads offline and
         references only BazaarGameShared, so they stay out. -->
    <Compile Remove="../../src/BazaarPlusPlus/Game/PostCombatImpact/Data/CombatImpactActiveAbilityReader.cs" />
    <Compile Remove="../../src/BazaarPlusPlus/Game/PostCombatImpact/Data/CombatImpactEntitySnapshotReader.cs" />
    <Compile Remove="../../src/BazaarPlusPlus/Game/PostCombatImpact/Data/CombatImpactEntityTags.cs" />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/CombatSimulation/*.cs"
      Link="CombatSimulation/%(Filename)%(Extension)"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/CombatReplay/CombatReplayPayloadStore.cs"
      Link="CombatReplayPayloadStore.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/PvpBattles/PvpReplayPayload.cs"
      Link="PvpReplayPayload.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/PvpBattles/PvpReplayPayloadCodec.cs"
      Link="PvpReplayPayloadCodec.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Infrastructure/AtomicFileWriter.cs"
      Link="AtomicFileWriter.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Infrastructure/FileBackedPayloadStore.cs"
      Link="FileBackedPayloadStore.cs"
    />
  </ItemGroup>
</Project>
