<Project Sdk="Microsoft.NET.Sdk">
  <!-- The Core item board planner plus the desktop host's mappers from a Core board back to the
       game's preview and native-board types. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>HistoryPanelPreview.Tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BazaarPlusPlus.Core/BazaarPlusPlus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/CardPreview/NativeCardPreviewSubject.cs"
      Link="NativeCardPreviewSubject.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/ItemBoardPreview/BppItemBoardPreviewMapper.cs"
      Link="BppItemBoardPreviewMapper.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/MonsterBoardPreview/NativeMonsterBoardItemMapper.cs"
      Link="NativeMonsterBoardItemMapper.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/Cards/DesktopCardFacets.cs"
      Link="DesktopCardFacets.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/Cards/NativeCardSetUp.Values.cs"
      Link="NativeCardSetUp.Values.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/Heroes/TheDragonsHeroIdentity.cs"
      Link="TheDragonsHeroIdentity.cs"
    />
    <Compile Include="HistoryPanelPreviewTests.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="BazaarGameShared">
      <HintPath>$(ManagedPath)/BazaarGameShared.dll</HintPath>
    </Reference>
    <Reference Include="BazaarGameClient">
      <HintPath>$(ManagedPath)/BazaarGameClient.dll</HintPath>
    </Reference>
    <Reference Include="TheBazaarRuntime">
      <HintPath>$(ManagedPath)/TheBazaarRuntime.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedPath)/UnityEngine.CoreModule.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
