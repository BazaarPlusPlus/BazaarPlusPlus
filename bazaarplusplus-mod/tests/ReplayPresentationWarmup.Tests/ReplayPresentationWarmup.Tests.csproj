<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BppRequiresManagedPath>false</BppRequiresManagedPath>
    <!-- Linked stats include audio/VFX fields whose native writers are outside this capsule. -->
    <NoWarn>$(NoWarn);CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Core/BazaarPlusPlus.Core.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Storage/BazaarPlusPlus.Storage.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <ProjectReference
      Include="../../src/BazaarPlusPlus.ModApi/BazaarPlusPlus.ModApi.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/CombatReplay/Warmup/PresentationWarmer.cs"
      Link="Production/PresentationWarmer.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/CombatReplay/Warmup/WarmupSharedTypes.cs"
      Link="Production/WarmupSharedTypes.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/CombatReplay/Warmup/ReplayAudioBankOwnership.cs"
      Link="Production/ReplayAudioBankOwnership.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/CombatReplay/CombatReplayLogCodes.cs"
      Link="Production/CombatReplayLogCodes.cs"
    />
  </ItemGroup>
</Project>
