<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Architecture.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference
      Include="../../src/BazaarPlusPlus/BazaarPlusPlus.csproj"
      ReferenceOutputAssembly="false"
    />
  </ItemGroup>

  <!-- CompiledArtifacts scans the main build in both configurations (ADR-0009): the project
       reference builds the current one, BuildScannedMainConfiguration builds the other. -->
  <PropertyGroup>
    <BppScannedMainProject>$(MSBuildThisFileDirectory)../../src/BazaarPlusPlus/BazaarPlusPlus.csproj</BppScannedMainProject>
    <BppScannedMainOutput>$(MSBuildThisFileDirectory)../../src/BazaarPlusPlus/bin/</BppScannedMainOutput>
    <BppScannedOtherConfiguration Condition="'$(Configuration)' == 'Release'"
      >Debug</BppScannedOtherConfiguration>
    <BppScannedOtherConfiguration Condition="'$(Configuration)' != 'Release'"
      >Release</BppScannedOtherConfiguration>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata
      Include="BppMainOutput.Debug"
      Value="$(BppScannedMainOutput)Debug/netstandard2.1"
    />
    <AssemblyMetadata
      Include="BppMainOutput.Release"
      Value="$(BppScannedMainOutput)Release/netstandard2.1"
    />
    <AssemblyMetadata Include="BppManagedPath" Value="$(ManagedPath)" />
  </ItemGroup>

  <!-- SharedAssemblies reads both targets of every shared project as metadata. The main project
       builds only netstandard2.1; these references build net10.0, so each names it over the
       tests' netstandard2.1 default (tests/Directory.Build.targets). -->
  <ItemGroup>
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Core/BazaarPlusPlus.Core.csproj"
      ReferenceOutputAssembly="false"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <ProjectReference
      Include="../../src/BazaarPlusPlus.ModApi/BazaarPlusPlus.ModApi.csproj"
      ReferenceOutputAssembly="false"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Storage/BazaarPlusPlus.Storage.csproj"
      ReferenceOutputAssembly="false"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <AssemblyMetadata
      Include="BppSharedOutput.BazaarPlusPlus.Core.netstandard2.1"
      Value="$(MSBuildThisFileDirectory)../../src/BazaarPlusPlus.Core/bin/$(Configuration)/netstandard2.1"
    />
    <AssemblyMetadata
      Include="BppSharedOutput.BazaarPlusPlus.Core.net10.0"
      Value="$(MSBuildThisFileDirectory)../../src/BazaarPlusPlus.Core/bin/$(Configuration)/net10.0"
    />
    <AssemblyMetadata
      Include="BppSharedOutput.BazaarPlusPlus.ModApi.netstandard2.1"
      Value="$(MSBuildThisFileDirectory)../../src/BazaarPlusPlus.ModApi/bin/$(Configuration)/netstandard2.1"
    />
    <AssemblyMetadata
      Include="BppSharedOutput.BazaarPlusPlus.ModApi.net10.0"
      Value="$(MSBuildThisFileDirectory)../../src/BazaarPlusPlus.ModApi/bin/$(Configuration)/net10.0"
    />
    <AssemblyMetadata
      Include="BppSharedOutput.BazaarPlusPlus.Storage.netstandard2.1"
      Value="$(MSBuildThisFileDirectory)../../src/BazaarPlusPlus.Storage/bin/$(Configuration)/netstandard2.1"
    />
    <AssemblyMetadata
      Include="BppSharedOutput.BazaarPlusPlus.Storage.net10.0"
      Value="$(MSBuildThisFileDirectory)../../src/BazaarPlusPlus.Storage/bin/$(Configuration)/net10.0"
    />
  </ItemGroup>
  <Target
    Name="BuildScannedMainConfiguration"
    AfterTargets="ResolveProjectReferences"
    Condition="'$(DesignTimeBuild)' != 'true'"
  >
    <MSBuild
      Projects="$(BppScannedMainProject)"
      Targets="Build"
      Properties="Configuration=$(BppScannedOtherConfiguration);BppDeployToGame=false"
      RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained"
    />
  </Target>
</Project>
