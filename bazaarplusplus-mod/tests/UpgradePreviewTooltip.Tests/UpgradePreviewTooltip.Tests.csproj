<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>UpgradePreviewTooltip.Tests</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BazaarPlusPlus.Core/BazaarPlusPlus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="../../src/BazaarPlusPlus/Game/Tooltips/UpgradePreviewValueProjection.cs"
      Link="UpgradePreviewValueProjection.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/Tooltips/UpgradePreviewAttributeMultiplierResolver.cs"
      Link="UpgradePreviewAttributeMultiplierResolver.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/Game/Tooltips/UpgradePreviewValueRegistry.cs"
      Link="UpgradePreviewValueRegistry.cs"
    />
    <Reference Include="BazaarGameClient">
      <HintPath>$(ManagedPath)/BazaarGameClient.dll</HintPath>
    </Reference>
    <Reference Include="BazaarGameShared">
      <HintPath>$(ManagedPath)/BazaarGameShared.dll</HintPath>
    </Reference>
    <Reference Include="TheBazaarRuntime">
      <HintPath>$(ManagedPath)/TheBazaarRuntime.dll</HintPath>
    </Reference>
  </ItemGroup>
</Project>
