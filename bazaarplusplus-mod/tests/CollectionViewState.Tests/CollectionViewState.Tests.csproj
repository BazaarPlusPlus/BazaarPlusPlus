<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>CollectionViewState.Tests</AssemblyName>
    <BppRequiresManagedPath>false</BppRequiresManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Named explicitly so the test tree's netstandard2.1 pin leaves Core and its references on
       net10.0, which `mod::test-core` runs without a Managed snapshot. Core keeps its
       Newtonsoft.Json private, so the source catalog parser's copy comes from here. -->
  <ItemGroup>
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Core/BazaarPlusPlus.Core.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Storage/BazaarPlusPlus.Storage.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <ProjectReference
      Include="../../src/BazaarPlusPlus.ModApi/BazaarPlusPlus.ModApi.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/LocalizationTestBootstrap.cs" Link="LocalizationTestBootstrap.cs" />
  </ItemGroup>
</Project>
