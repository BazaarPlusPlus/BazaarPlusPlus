<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs in `just mod::test-core`, which needs the Interop Snapshot but no Managed/ snapshot. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>AndroidHost.Tests</AssemblyName>
    <BppRequiresManagedPath>false</BppRequiresManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- The History reader touches no game type, so its source runs here against the real schema
       through Core's net10.0 output (Storage and Microsoft.Data.Sqlite come with it). -->
  <ItemGroup>
    <Compile
      Include="../../src/BazaarPlusPlus.Android/History/AndroidHistoryReader.cs"
      Link="AndroidHistoryReader.cs"
    />
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Core/BazaarPlusPlus.Core.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <!-- Named explicitly so the test tree's netstandard2.1 pin leaves Core's transitive references
         alone; the Mono targets need the Managed snapshot the mod-android lane does not fetch. -->
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Storage/BazaarPlusPlus.Storage.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <ProjectReference
      Include="../../src/BazaarPlusPlus.ModApi/BazaarPlusPlus.ModApi.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
  </ItemGroup>

  <!-- The host is scanned as a compiled artifact, never loaded: its references resolve only
       inside the game process. -->
  <ItemGroup>
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Android/BazaarPlusPlus.Android.csproj"
      ReferenceOutputAssembly="false"
    />
    <AssemblyMetadata
      Include="BppAndroidHostAssembly"
      Value="$(MSBuildThisFileDirectory)../../src/BazaarPlusPlus.Android/bin/$(Configuration)/net10.0/BazaarPlusPlus.Android.dll"
    />
    <AssemblyMetadata
      Include="BppUpdaterAssembly"
      Value="$(MSBuildThisFileDirectory)../../src/BazaarPlusPlus.Updater/bin/$(Configuration)/net10.0/BazaarPlusPlus.Updater.dll"
    />
  </ItemGroup>
</Project>
