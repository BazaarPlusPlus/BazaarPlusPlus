<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>RemoteEmbeddedDataPipeline.Tests</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="../../build/RemoteEmbeddedDataFetcher/RemoteEmbeddedDataFetch.cs"
      Link="RemoteEmbeddedDataFetch.cs"
    />
    <Compile
      Include="../../build/RemoteEmbeddedDataFetcher/RemoteEmbeddedDataHttpClient.cs"
      Link="RemoteEmbeddedDataHttpClient.cs"
    />
    <Compile Include="RemoteEmbeddedDataPipelineTests.cs" />
    <Compile Include="AssemblyInfo.cs" />
  </ItemGroup>
</Project>
