<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- The production ModApi project references MessagePack compile-only (the game ships the
         runtime DLL). The standalone test host has no game DLL, so it needs the runtime asset. -->
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BazaarPlusPlus.ModApi/BazaarPlusPlus.ModApi.csproj" />
    <EmbeddedResource
      Include="../../../bazaarplusplus-server/contracts/mod-api-errors.json"
      LogicalName="ModApi.Tests.mod-api-errors.json"
    />
  </ItemGroup>
</Project>
