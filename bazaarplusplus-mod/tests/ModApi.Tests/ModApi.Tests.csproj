<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>ModApi.Tests</AssemblyName>
    <BppReferenceGameLibraries>true</BppReferenceGameLibraries>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The Desktop Host's configuration: the netstandard2.1 output bound to the game's libraries.
         ModApi.Net10.Tests runs the same sources against the net10.0 output (ADR-0013). -->
    <ProjectReference
      Include="../../src/BazaarPlusPlus.ModApi/BazaarPlusPlus.ModApi.csproj"
      SetTargetFramework="TargetFramework=netstandard2.1"
    />
    <EmbeddedResource
      Include="../../../bazaarplusplus-server/contracts/mod-api-errors.json"
      LogicalName="ModApi.Tests.mod-api-errors.json"
    />
    <EmbeddedResource
      Include="../../../bazaarplusplus-server/contracts/v6/ghost-summary.response.json"
      LogicalName="ModApi.Tests.ghost-summary.response.json"
    />
  </ItemGroup>
</Project>
