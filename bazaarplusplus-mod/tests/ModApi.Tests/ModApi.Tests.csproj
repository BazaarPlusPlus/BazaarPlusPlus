<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BppReferenceGameLibraries>true</BppReferenceGameLibraries>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Mono host's configuration: the netstandard2.1 output bound to the game's libraries.
         ModApi.Net10.Tests runs the same sources against the net10.0 output (ADR-0013). -->
    <ProjectReference
      Include="../../src/BazaarPlusPlus.ModApi/BazaarPlusPlus.ModApi.csproj"
      SetTargetFramework="TargetFramework=netstandard2.1"
    />
    <EmbeddedResource
      Include="../../../bazaarplusplus-server/contracts/mod-api-errors.json"
      LogicalName="ModApi.Tests.mod-api-errors.json"
    />
    <EmbeddedResource
      Include="../../../bazaarplusplus-server/contracts/v6/ghost-summary.response.json"
      LogicalName="ModApi.Tests.ghost-summary.response.json"
    />
  </ItemGroup>
</Project>
