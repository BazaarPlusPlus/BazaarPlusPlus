<Project Sdk="Microsoft.NET.Sdk">
  <!-- The release manifest client, the Android game update and the check lifecycle, run against
       Core alone over the shared Release Manifest fixtures. Needs no game snapshot, so
       `mod::test` and `mod::test-core` both run it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>ReleaseManifestClient.Tests</AssemblyName>
    <BppRequiresManagedPath>false</BppRequiresManagedPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Core keeps its net10.0 Newtonsoft.Json private; the test supplies the runtime copy. -->
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <!-- Named explicitly so the test tree's netstandard2.1 pin leaves Core and its references on
       net10.0; the Mono targets need the Managed snapshot `mod::test-core` does not fetch. -->
  <ItemGroup>
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Core/BazaarPlusPlus.Core.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Storage/BazaarPlusPlus.Storage.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
    <ProjectReference
      Include="../../src/BazaarPlusPlus.ModApi/BazaarPlusPlus.ModApi.csproj"
      SetTargetFramework="TargetFramework=net10.0"
    />
  </ItemGroup>

  <ItemGroup>
    <Content
      Include="../../../release/fixtures/latest.json"
      Link="fixtures/latest.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="../../../release/fixtures/latest/windows-x86_64.json"
      Link="fixtures/latest/windows-x86_64.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="../../../release/fixtures/latest/darwin-aarch64.json"
      Link="fixtures/latest/darwin-aarch64.json"
      CopyToOutputDirectory="PreserveNewest"
    />
    <Content
      Include="../../../release/fixtures/latest/android-aarch64.json"
      Link="fixtures/latest/android-aarch64.json"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
