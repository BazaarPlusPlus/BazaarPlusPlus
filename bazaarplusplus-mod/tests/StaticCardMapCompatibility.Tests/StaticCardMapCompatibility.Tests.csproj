<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>StaticCardMapCompatibility.Tests</AssemblyName>
    <BppReferenceGameLibraries>true</BppReferenceGameLibraries>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <None Update="Pantry.json" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="SourceGear.sqlite3" />
    <Reference Include="BazaarGameShared">
      <HintPath>$(ManagedPath)/BazaarGameShared.dll</HintPath>
    </Reference>
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/StaticCards/CompatibleCardMapReader.cs"
      Link="CompatibleCardMapReader.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/StaticCards/CompatibleUniqueCardCount.cs"
      Link="CompatibleUniqueCardCount.cs"
    />
    <Compile
      Include="../../src/BazaarPlusPlus/GameInterop/StaticCards/CompatibleCardValueConverter.cs"
      Link="CompatibleCardValueConverter.cs"
    />
  </ItemGroup>
</Project>
