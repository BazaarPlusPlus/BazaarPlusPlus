<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BppReferenceGameLibraries>true</BppReferenceGameLibraries>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Mono host's configuration: the netstandard2.1 output bound to the game's libraries.
         Storage.Net10.Tests runs the same sources against the net10.0 output (ADR-0013). -->
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Storage/BazaarPlusPlus.Storage.csproj"
      SetTargetFramework="TargetFramework=netstandard2.1"
    />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="../../src/BazaarPlusPlus.Storage/BazaarPlusPlus.history-database.json"
      Link="BazaarPlusPlus.history-database.json"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
