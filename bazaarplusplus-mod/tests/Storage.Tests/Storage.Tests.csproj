<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Storage.Tests</AssemblyName>
    <BppReferenceGameLibraries>true</BppReferenceGameLibraries>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- The Desktop Host's configuration: the netstandard2.1 output bound to the game's libraries.
         Storage.Net10.Tests runs the same sources against the net10.0 output (ADR-0013). -->
    <ProjectReference
      Include="../../src/BazaarPlusPlus.Storage/BazaarPlusPlus.Storage.csproj"
      SetTargetFramework="TargetFramework=netstandard2.1"
    />
  </ItemGroup>

  <ItemGroup>
    <None
      Include="../../src/BazaarPlusPlus.Storage/BazaarPlusPlus.history-database.json"
      Link="BazaarPlusPlus.history-database.json"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
