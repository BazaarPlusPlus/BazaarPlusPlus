<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/BazaarPlusPlus.Storage/BazaarPlusPlus.Storage.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile
      Include="..\..\src\BazaarPlusPlus\Infrastructure\Logging\Core\*.cs"
      Link="Logging\Core\%(Filename)%(Extension)"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\RunLogging\RunLoggingLogEvents.cs"
      Link="RunLoggingLogEvents.cs"
    />
    <Compile
      Include="..\..\src\BazaarPlusPlus\Game\RunLogging\RunLogStoreLoggerBridge.cs"
      Link="RunLogStoreLoggerBridge.cs"
    />
  </ItemGroup>
</Project>
