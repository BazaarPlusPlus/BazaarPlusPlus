<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BppReferenceGameLibraries>true</BppReferenceGameLibraries>
  </PropertyGroup>

  <ItemGroup></ItemGroup>

  <ItemGroup>
    <!-- The Mono host's configuration: the netstandard2.1 output bound to the game's libraries.
         BundleV6Codec.Net10.Tests runs the same sources against the net10.0 output (ADR-0013). -->
    <ProjectReference
      Include="../../src/BazaarPlusPlus.ModApi/BazaarPlusPlus.ModApi.csproj"
      SetTargetFramework="TargetFramework=netstandard2.1"
    />
  </ItemGroup>

  <ItemGroup>
    <None Update="fixtures/run-payload-v6.fixture.b64" CopyToOutputDirectory="PreserveNewest" />
    <None
      Include="../../../bazaarplusplus-server/contracts/v6/fixtures/*"
      Link="fixtures/%(Filename)%(Extension)"
      CopyToOutputDirectory="PreserveNewest"
    />
  </ItemGroup>
</Project>
