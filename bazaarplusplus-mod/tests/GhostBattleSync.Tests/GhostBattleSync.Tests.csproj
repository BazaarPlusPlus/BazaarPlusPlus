<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Ghost discovery, download and payload storage are Core services; the game-typed reads come
       from a fake evidence binding (BundlePipeline.Tests covers the desktop's). -->
  <ItemGroup>
    <ProjectReference Include="../../src/BazaarPlusPlus.Core/BazaarPlusPlus.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Shared/LocalizationTestBootstrap.cs" Link="LocalizationTestBootstrap.cs" />
    <EmbeddedResource
      Include="../../../bazaarplusplus-server/contracts/v6/ghost-summary.response.json"
      LogicalName="GhostBattleSync.Tests.ghost-summary.response.json"
    />
  </ItemGroup>
</Project>
