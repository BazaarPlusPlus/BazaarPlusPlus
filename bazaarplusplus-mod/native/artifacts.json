          "buildScript": "native/windows/build.ps1",
          "outputPath": "GfxPluginBppReplayMediaFoundation.dll",
          "binaryPath": "GfxPluginBppReplayMediaFoundation.dll",
          "kind": "file",
          "destinationPath": "src-tauri/resources/SourceForBuild/windows/TheBazaar_Data/Plugins/x86_64/GfxPluginBppReplayMediaFoundation.dll",
          "requiredExports": [
            "BppMfAcquireSlot",
            "BppMfCanMuxAudio",
            "BppMfCancelRenderEvent",
            "BppMfCommitRenderEvent",
            "BppMfCopyEncoderName",
            "BppMfCopyError",
            "BppMfCreate",
            "BppMfDestroy",
            "BppMfDiscardRenderEvent",
            "BppMfFinish",
            "BppMfGetRenderEventFunc",
            "BppMfGetSlotCount",
            "BppMfGetStats",
            "BppMfHasUnityD3D11Interface",
