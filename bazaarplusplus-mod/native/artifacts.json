            "BppVtCancelRenderEvent",
            "BppVtCommitRenderEvent",
            "BppVtCopyError",
            "BppVtCreate",
            "BppVtDestroy",
            "BppVtDiscardRenderEvent",
            "BppVtFinish",
            "BppVtGetRenderEventFunc",
            "BppVtGetSlotCount",
            "BppVtGetStats",
            "BppVtHasUnityMetalInterface",
            "BppVtIsFailed",
            "BppVtMuxAudio",
            "BppVtPrepareRenderEvent",
            "BppVtReleaseSlot",
            "UnityPluginLoad",
            "UnityPluginUnload"
          ],
          "requiredWeakImports": [],
          "allowedDependencyPrefixes": [
            "/System/Library/",
            "/usr/lib/"
          ]
        }
      ]
    },
    "windows": {
      "architecture": "x64",
      "signing": "unsigned",
      "inputs": [
        "native/windows/BppReplayMediaFoundation.cpp",
        "native/windows/BppReplayMediaFoundation.h",
        "native/windows/BppReplayMediaFoundationSmoke.cpp",
        "native/windows/build.ps1",
        "native/windows/test.ps1",
        "src/BazaarPlusPlus/Game/CombatReplay/Video/WindowsMediaFoundationVideoEncoder.cs",
