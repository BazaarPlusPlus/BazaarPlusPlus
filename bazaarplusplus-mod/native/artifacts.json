        "native/mac-audio-tap/BppMacAudio.h",
        "native/mac-audio-tap/BppMacAudio.m",
        "native/mac-audio-tap/build.sh",
        "native/macos/BppNativeLoadSmoke.c",
        "native/macos/BppReplayAudioMuxer.mm",
