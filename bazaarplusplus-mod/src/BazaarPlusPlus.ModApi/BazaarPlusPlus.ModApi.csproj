<Project Sdk="Microsoft.NET.Sdk">
  <!-- Owns the wire contract with the mod backend and carries MessagePack and HTTP (ADR-0012).
       Both targets compile the same sources into same-named, same-version outputs (ADR-0013). -->
  <PropertyGroup>
    <AssemblyName>BazaarPlusPlus.ModApi</AssemblyName>
    <RootNamespace>BazaarPlusPlus.ModApi</RootNamespace>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <Version>$(BppVersion)</Version>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- The Mono host binds the game's own MessagePack and Newtonsoft.Json (ADR-0010). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <BppReferenceGameLibraries>true</BppReferenceGameLibraries>
  </PropertyGroup>

  <!-- net10.0 binds no game assembly, so it builds where only the Interop Snapshot is fetched
       (the Android host and the mod-android lane). -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <BppRequiresManagedPath>false</BppRequiresManagedPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="NETStandard.Library" />
  </ItemGroup>

  <!-- The CoreCLR host binds the packages pinned to the game's versions. Private, so each host
       supplies its own runtime copies (ADR-0013). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="MessagePack" PrivateAssets="all" />
    <PackageReference Include="Newtonsoft.Json" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The source generator must match the game's MessagePack runtime (ADR-0010). -->
    <PackageReference Include="MessagePackAnalyzer" PrivateAssets="all" />
  </ItemGroup>
</Project>
