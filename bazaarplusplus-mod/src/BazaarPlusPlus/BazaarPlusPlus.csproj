<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build properties -->
  <PropertyGroup>
    <AssemblyName>BazaarPlusPlus</AssemblyName>
    <Description>BazaarPlusPlus - Game Enhancement Mod</Description>
    <RootNamespace>BazaarPlusPlus</RootNamespace>
    <Version>$(BppVersion)</Version>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TargetFramework>netstandard2.1</TargetFramework>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Krafs.Publicizer generates IgnoresAccessChecksToAttribute into AssemblyInfo, while
         MonoMod.Utils provides the same type. Scope this generated-source conflict to the
         publicized plugin project instead of weakening the repository warning gate. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
    <BuildProductionPackage Condition="'$(BuildProductionPackage)' == ''"
      >false</BuildProductionPackage>
  </PropertyGroup>

  <Import Project="RemoteEmbeddedData.targets" />
  <Import Project="$(MSBuildThisFileDirectory)../../../release/generated/Payload.targets" />

  <ItemGroup>
    <EmbeddedResource
      Include="Resources\HistoryPanel\run-state-badges.png"
      LogicalName="BazaarPlusPlus.Resources.HistoryPanel.run-state-badges.png"
    />
    <EmbeddedResource
      Include="Resources\HistoryPanel\battle-result-badges.png"
      LogicalName="BazaarPlusPlus.Resources.HistoryPanel.battle-result-badges.png"
    />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="Resources\HistoryPanel\history-menu.png"
      LogicalName="BazaarPlusPlus.Resources.HistoryPanel.history-menu.png"
    />
  </ItemGroup>

  <!-- Embedded resources -->
  <ItemGroup>
    <EmbeddedResource Include="Data\CollectionSources\collection-sources.json" />
    <EmbeddedResource
      Include="Game\Supporters\supporter-list.json"
      LogicalName="BazaarPlusPlus.Game.Supporters.supporter-list.json"
    />
    <EmbeddedResource
      Include="Resources\DockButtons\collection-panel-icon.png"
      LogicalName="BazaarPlusPlus.Resources.DockButtons.collection-panel-icon.png"
    />
    <EmbeddedResource
      Include="Resources\DockButtons\replay-export-icon.png"
      LogicalName="BazaarPlusPlus.Resources.DockButtons.replay-export-icon.png"
    />
    <EmbeddedResource
      Include="Resources\DockButtons\replay-recording-icon.png"
      LogicalName="BazaarPlusPlus.Resources.DockButtons.replay-recording-icon.png"
    />
    <EmbeddedResource
      Include="Resources\DockButtons\replay-view-icon.png"
      LogicalName="BazaarPlusPlus.Resources.DockButtons.replay-view-icon.png"
    />
    <EmbeddedResource
      Include="Resources\DockButtons\replay-retry-icon.png"
      LogicalName="BazaarPlusPlus.Resources.DockButtons.replay-retry-icon.png"
    />
  </ItemGroup>

  <!-- Project paths -->
  <PropertyGroup>
    <ProjectRoot>$(MSBuildThisFileDirectory)</ProjectRoot>
    <BPPInstallerSourcePath>$(ProjectRoot)/../../../bazaarplusplus-installer/src-tauri/resources</BPPInstallerSourcePath>
    <HistoryDatabaseContractFile>$(ProjectRoot)/../BazaarPlusPlus.Storage/BazaarPlusPlus.history-database.json</HistoryDatabaseContractFile>
    <HostArchitecture>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</HostArchitecture>
    <IsMacHost>$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::OSX)))</IsMacHost>
    <IsWindowsHost>$([System.Runtime.InteropServices.RuntimeInformation]::IsOSPlatform($([System.Runtime.InteropServices.OSPlatform]::Windows)))</IsWindowsHost>
    <MacSqliteRuntimeRid>osx-arm64</MacSqliteRuntimeRid>
    <WindowsSqliteRuntimeRid>win-x64</WindowsSqliteRuntimeRid>
    <FixedMacSqliteNativeFile>$(PkgSourceGear_sqlite3)/runtimes/$(MacSqliteRuntimeRid)/native/libe_sqlite3.dylib</FixedMacSqliteNativeFile>
    <FixedMacAudioTapNativeFile>$(BPPInstallerSourcePath)/SourceForBuild/macos/BepInEx/plugins/libBppMacAudio.dylib</FixedMacAudioTapNativeFile>
    <FixedWindowsSqliteNativeFile>$(PkgSourceGear_sqlite3)/runtimes/$(WindowsSqliteRuntimeRid)/native/e_sqlite3.dll</FixedWindowsSqliteNativeFile>
    <LocalMacReplayPluginBundle>$(ProjectRoot)/../../native/macos/build/GfxPluginBppReplayVideoToolbox.bundle</LocalMacReplayPluginBundle>
    <InstallerMacReplayPluginBundle>$(BPPInstallerSourcePath)/SourceForBuild/macos/TheBazaar.app/Contents/Plugins/GfxPluginBppReplayVideoToolbox.bundle</InstallerMacReplayPluginBundle>
    <MacReplayPluginBundle
      Condition="'$(IsMacHost)' == 'true' and '$(MacReplayPluginBundle)' == '' and Exists('$(LocalMacReplayPluginBundle)')"
      >$(LocalMacReplayPluginBundle)</MacReplayPluginBundle>
    <MacReplayPluginBundle
      Condition="'$(IsMacHost)' == 'true' and '$(MacReplayPluginBundle)' == '' and Exists('$(InstallerMacReplayPluginBundle)')"
      >$(InstallerMacReplayPluginBundle)</MacReplayPluginBundle>
    <LocalWindowsReplayPlugin>$(ProjectRoot)/../../native/windows/build/GfxPluginBppReplayMediaFoundation.dll</LocalWindowsReplayPlugin>
    <InstallerWindowsReplayPlugin>$(BPPInstallerSourcePath)/SourceForBuild/windows/TheBazaar_Data/Plugins/x86_64/GfxPluginBppReplayMediaFoundation.dll</InstallerWindowsReplayPlugin>
    <WindowsReplayPlugin
      Condition="'$(IsWindowsHost)' == 'true' and '$(WindowsReplayPlugin)' == '' and Exists('$(LocalWindowsReplayPlugin)')"
      >$(LocalWindowsReplayPlugin)</WindowsReplayPlugin>
    <WindowsReplayPlugin
      Condition="'$(IsWindowsHost)' == 'true' and '$(WindowsReplayPlugin)' == '' and Exists('$(InstallerWindowsReplayPlugin)')"
      >$(InstallerWindowsReplayPlugin)</WindowsReplayPlugin>
  </PropertyGroup>
  <!-- Package references -->
  <ItemGroup>
    <PackageReference Include="BepInEx.Analyzers" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" />
    <PackageReference Include="BepInEx.PluginInfoProps" />
    <PackageReference Include="Krafs.Publicizer" PrivateAssets="all" />
    <PackageReference Include="SixLabors.ImageSharp" />
    <PackageReference Include="UnityEngine.Modules" IncludeAssets="compile" />
    <PackageReference Include="NETStandard.Library" />
    <PackageReference
      Include="System.Runtime.CompilerServices.Unsafe"
      PrivateAssets="all"
      ExcludeAssets="runtime"
    />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="SourceGear.sqlite3" GeneratePathProperty="true" />
    <PackageReference Include="Newtonsoft.Json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../BazaarPlusPlus.ModApi/BazaarPlusPlus.ModApi.csproj" />
    <ProjectReference Include="../BazaarPlusPlus.Storage/BazaarPlusPlus.Storage.csproj" />
    <ProjectReference Include="../BazaarPlusPlus.Localization/BazaarPlusPlus.Localization.csproj" />
  </ItemGroup>

  <!-- Game assembly references -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedPath)\Assembly-CSharp.dll</HintPath>
    </Reference>
    <Reference Include="BazaarBattleService">
      <HintPath>$(ManagedPath)\BazaarBattleService.dll</HintPath>
    </Reference>
    <Reference Include="BazaarGameClient">
      <HintPath>$(ManagedPath)\BazaarGameClient.dll</HintPath>
    </Reference>
    <Reference Include="BazaarGameShared">
      <HintPath>$(ManagedPath)\BazaarGameShared.dll</HintPath>
    </Reference>
    <Reference Include="TheBazaarRuntime">
      <HintPath>$(ManagedPath)\TheBazaarRuntime.dll</HintPath>
    </Reference>
    <Reference Include="Addressables">
      <HintPath>$(ManagedPath)\Unity.Addressables.dll</HintPath>
    </Reference>
    <Reference Include="ResourceManager">
      <HintPath>$(ManagedPath)\Unity.ResourceManager.dll</HintPath>
    </Reference>
    <Reference Include="Unity.InputSystem">
      <HintPath>$(ManagedPath)\Unity.InputSystem.dll</HintPath>
    </Reference>
    <Reference Include="DOTween">
      <HintPath>$(ManagedPath)\DOTween.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(ManagedPath)\UnityEngine.UI.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.ImageConversionModule">
      <HintPath>$(ManagedPath)\UnityEngine.ImageConversionModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.UIElementsModule">
      <HintPath>$(ManagedPath)\UnityEngine.UIElementsModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextCoreTextEngineModule">
      <HintPath>$(ManagedPath)\UnityEngine.TextCoreTextEngineModule.dll</HintPath>
    </Reference>
    <Reference Include="UnityEngine.TextCoreFontEngineModule">
      <HintPath>$(ManagedPath)\UnityEngine.TextCoreFontEngineModule.dll</HintPath>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(ManagedPath)\Unity.TextMeshPro.dll</HintPath>
    </Reference>
    <Reference Include="MessagePack">
      <HintPath>$(ManagedPath)\MessagePack.dll</HintPath>
    </Reference>
    <Reference Include="FMODUnity">
      <HintPath>$(ManagedPath)\FMODUnity.dll</HintPath>
    </Reference>
  </ItemGroup>

  <!-- Publicize all game assemblies -->
  <PropertyGroup>
    <PublicizeAll>true</PublicizeAll>
  </PropertyGroup>
  <!-- Debug build -->
  <Target
    Name="CopyToBepInExPlugins"
    DependsOnTargets="CollectPayloadFiles"
    AfterTargets="Build"
    Condition="'$(Configuration)' == 'Debug' and '$(BppDeployToGame)' == 'true' and '$(GamePath)' != ''"
  >
    <Message Text="[BazaarPlusPlus] Building for Debug" Importance="high" />
    <ItemGroup>
      <BppDebugPayloadFile
        Include="@(BppPayloadFile)"
        Condition="'%(BppPayloadFile.PayloadPath)' != 'BepInEx/plugins/BazaarPlusPlus.version'"
      />
      <MacAudioTapNativeFile
        Include="$(FixedMacAudioTapNativeFile)"
        Condition="'$(IsMacHost)' == 'true' and Exists('$(FixedMacAudioTapNativeFile)')"
      />
    </ItemGroup>
    <ItemGroup Condition="'$(IsMacHost)' == 'true'">
      <StaleMacRecordingFile Include="$(GamePath)/BepInEx/plugins/ffmpeg" />
      <StaleMacRecordingFile Include="$(GamePath)/BepInEx/plugins/ffmpeg-LICENSE.txt" />
    </ItemGroup>
    <Delete Files="@(StaleMacRecordingFile)" Condition="'$(IsMacHost)' == 'true'" />
    <RemoveDir
      Directories="$(GamePath)/BepInEx/plugins/BppReplayRecorder.app"
      Condition="'$(IsMacHost)' == 'true'"
    />
    <Copy
      SourceFiles="@(BppDebugPayloadFile)"
      DestinationFiles="@(BppDebugPayloadFile->'$(GamePath)/%(PayloadPath)')"
      SkipUnchangedFiles="true"
    />
    <Copy
      SourceFiles="@(MacAudioTapNativeFile)"
      DestinationFiles="$(GamePath)/BepInEx/plugins/libBppMacAudio.dylib"
      SkipUnchangedFiles="true"
      Condition="'@(MacAudioTapNativeFile)' != ''"
    />
    <!-- Unity must load the rendering bundle before managed plugins start so UnityPluginLoad can
         provide IUnityGraphicsMetal. Copy only when a reviewed prebuilt or local native build is
         available; ordinary C# builds remain toolchain-independent. -->
    <RemoveDir
      Directories="$(GamePath)/TheBazaar.app/Contents/Plugins/GfxPluginBppReplayVideoToolbox.bundle"
      Condition="'$(MacReplayPluginBundle)' != ''"
    />
    <Exec
      Command="/usr/bin/ditto &quot;$(MacReplayPluginBundle)&quot; &quot;$(GamePath)/TheBazaar.app/Contents/Plugins/GfxPluginBppReplayVideoToolbox.bundle&quot;"
      Condition="'$(MacReplayPluginBundle)' != ''"
    />
    <Exec
      Command="BPP_GAME_ROOT=&quot;$(GamePath)&quot; BPP_TRAMPOLINE_STUB=&quot;$(BPPInstallerSourcePath)/Trampoline/macos/bpp_launcher&quot; /bin/bash &quot;$(ProjectRoot)/../../scripts/repair-macos-trampoline.sh&quot;"
      Condition="'$(MacReplayPluginBundle)' != ''"
    />
    <!-- Unity must preload the Windows rendering plugin before BepInEx starts. -->
    <MakeDir
      Directories="$(GamePath)\TheBazaar_Data\Plugins\x86_64"
      Condition="'$(IsWindowsHost)' == 'true' and '$(WindowsReplayPlugin)' != ''"
    />
    <Copy
      SourceFiles="$(WindowsReplayPlugin)"
      DestinationFiles="$(GamePath)\TheBazaar_Data\Plugins\x86_64\GfxPluginBppReplayMediaFoundation.dll"
      SkipUnchangedFiles="true"
      Condition="'$(IsWindowsHost)' == 'true' and '$(WindowsReplayPlugin)' != ''"
    />
    <ItemGroup>
      <StaleWindowsFfmpegFile Include="$(GamePath)\BepInEx\plugins\ffmpeg.exe" />
      <StaleWindowsFfmpegFile Include="$(GamePath)\BepInEx\plugins\ffmpeg-LICENSE.txt" />
    </ItemGroup>
    <Delete Files="@(StaleWindowsFfmpegFile)" />
    <WriteLinesToFile
      File="$(GamePath)\BepInEx\plugins\$(TargetName).version"
      Lines="$(Version).t$([System.DateTime]::Now.ToString('yyyyMMdd.HHmmss')).dev"
      Overwrite="true"
    />
    <Message
      Text="[BazaarPlusPlus] Successfully copied DLL to BepInEx plugins folder!!!"
      Importance="high"
    />
  </Target>

  <!-- Production builds write only into the coordinator's isolated staging tree. -->
  <Target
    Name="ValidateProductionReleasePlatform"
    BeforeTargets="CopyToInstallerSource"
    Condition="'$(Configuration)' == 'Release' and '$(BuildProductionPackage)' == 'true'"
  >
    <Error
      Condition="'$(BppReleasePlatform)' != 'macos' and '$(BppReleasePlatform)' != 'windows'"
      Text="BppReleasePlatform must be macos or windows for a production payload."
    />
    <Error
      Condition="'$(BppPayloadStagingRoot)' == '' or '$(BPPInstallerSourcePath)' != '$(BppPayloadStagingRoot)'"
      Text="Production payloads require isolated staging. Run node release.mjs prepare."
    />
  </Target>

  <Target
    Name="CopyToInstallerSource"
    AfterTargets="Build"
    DependsOnTargets="ValidatePayloadAssemblyVersions"
    Condition="'$(Configuration)' == 'Release' and '$(BuildProductionPackage)' == 'true'"
  >
    <WriteLinesToFile
      File="$(TargetDir)$(TargetName).version"
      Lines="$(Version).prod"
      Overwrite="true"
    />
    <Copy
      SourceFiles="@(BppPayloadFile)"
      DestinationFiles="@(BppPayloadFile->'$(BPPInstallerSourcePath)/SourceForBuild/$(BppReleasePlatform)/%(PayloadPath)')"
    />
  </Target>

  <!-- Build all -->
  <Target Name="BuildAll" DependsOnTargets="EnsureRemoteEmbeddedData">
    <MSBuild
      Projects="$(MSBuildProjectFile)"
      Targets="Build"
      Properties="Configuration=Debug;RemoteEmbeddedDataPrepared=true;BppDeployToGame=false"
    />
    <MSBuild
      Projects="$(MSBuildProjectFile)"
      Targets="Build"
      Properties="Configuration=Release;BuildProductionPackage=$(BuildProductionPackage);BppReleasePlatform=$(BppReleasePlatform);RemoteEmbeddedDataPrepared=true"
    />
  </Target>
</Project>
