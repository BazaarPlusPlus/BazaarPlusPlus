<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Android Host (root CONTEXT.md; docs/ARCHITECTURE.md Hosts): a LemonLoader MelonMod on
    CoreCLR that compiles against the Interop Snapshot and the Loader Release, never against
    Managed/ and never publicized. net10.0 is the TFM of the Loader Release's own MelonLoader.dll.
  -->
  <PropertyGroup>
    <AssemblyName>BazaarPlusPlus.Android</AssemblyName>
    <RootNamespace>BazaarPlusPlus.Android</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <Version>$(BppVersion)</Version>
    <Deterministic>true</Deterministic>
    <!-- No deps.json: the loader supplies the game, interop, and loader assemblies, and BPP's own
         ships beside the host per the Payload Inventory (release/payload.json). -->
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <!-- Game assemblies come from InteropPath, so the desktop ManagedPath check does not apply. -->
    <BppRequiresManagedPath>false</BppRequiresManagedPath>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)../../build/InteropPath.props" />

  <!--
    The Android Mod Payload (release/payload.json, host melonloader): Payload.targets collects the
    MelonLoader entries; the Android `release.mjs prepare` stages them through
    CopyToPayloadStaging below, which `release/android-release.mjs` then zips and bakes into the APK.
  -->
  <PropertyGroup>
    <BppPayloadHost>melonloader</BppPayloadHost>
    <HistoryDatabaseContractFile>$(MSBuildThisFileDirectory)../BazaarPlusPlus.Storage/BazaarPlusPlus.history-database.json</HistoryDatabaseContractFile>
    <BppUpdaterFile>$(MSBuildThisFileDirectory)../BazaarPlusPlus.Updater/bin/$(Configuration)/net10.0/BazaarPlusPlus.Updater.dll</BppUpdaterFile>
    <BuildProductionPackage Condition="'$(BuildProductionPackage)' == ''"
      >false</BuildProductionPackage>
  </PropertyGroup>
  <Import Project="$(MSBuildThisFileDirectory)../../../release/generated/Payload.targets" />

  <ItemGroup>
    <Reference Include="$(LemonLoaderManagedPath)MelonLoader.dll" Private="false" />
    <Reference Include="$(LemonLoaderManagedPath)0Harmony.dll" Private="false" />
    <Reference Include="$(LemonLoaderManagedPath)Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(InteropPath)*.dll" Private="false" />
  </ItemGroup>

  <!-- The melon's identity, versioned from VERSION like every BPP assembly. -->
  <ItemGroup>
    <AssemblyAttribute Include="MelonLoader.MelonInfoAttribute">
      <_Parameter1>typeof(BazaarPlusPlus.Android.Host.AndroidMod)</_Parameter1>
      <_Parameter1_IsLiteral>true</_Parameter1_IsLiteral>
      <_Parameter2>BazaarPlusPlus</_Parameter2>
      <_Parameter3>$(BppVersion)</_Parameter3>
      <_Parameter4>BazaarPlusPlus</_Parameter4>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    Shared code comes from Core's net10.0 output (ADR-0012), never from linked desktop sources;
    Storage and ModApi arrive through it. They keep their serializer packages private
    (ADR-0013 §2), so the host adds Newtonsoft.Json and MessagePack when it first loads code that
    serializes: the record chain (#359), with the Android Payload (#357).
  -->
  <ItemGroup>
    <ProjectReference Include="../BazaarPlusPlus.Core/BazaarPlusPlus.Core.csproj" />
  </ItemGroup>

  <!-- The Updater ships in the Payload (MelonLoader/Plugins/) and is built for it, never
       referenced: it runs before the Mods load and may not depend on them (ADR-0014). -->
  <ItemGroup>
    <ProjectReference
      Include="../BazaarPlusPlus.Updater/BazaarPlusPlus.Updater.csproj"
      ReferenceOutputAssembly="false"
      SetTargetFramework="TargetFramework=net10.0"
    />
  </ItemGroup>

  <!-- Production builds write only into the release coordinator's isolated staging tree. -->
  <Target
    Name="ValidateAndroidProductionPayload"
    BeforeTargets="CopyToPayloadStaging"
    Condition="'$(Configuration)' == 'Release' and '$(BuildProductionPackage)' == 'true'"
  >
    <Error
      Condition="'$(BppReleasePlatform)' != 'android'"
      Text="BppReleasePlatform must be android for an Android production payload."
    />
    <Error
      Condition="'$(BppPayloadStagingRoot)' == ''"
      Text="Production payloads require isolated staging. Run node release.mjs prepare --platform android."
    />
  </Target>

  <Target
    Name="CopyToPayloadStaging"
    AfterTargets="Build"
    DependsOnTargets="CollectPayloadFiles"
    Condition="'$(Configuration)' == 'Release' and '$(BuildProductionPackage)' == 'true'"
  >
    <WriteLinesToFile
      File="$(TargetDir)BazaarPlusPlus.version"
      Lines="$(Version).prod"
      Overwrite="true"
    />
    <!-- Every MelonLoader entry the inventory requires; the missing ones are named here instead
         of failing as an anonymous copy error. -->
    <ItemGroup>
      <_BppMissingPayloadFile Include="@(BppPayloadFile)" Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <Error
      Condition="'@(_BppMissingPayloadFile)' != ''"
      Text="The Android Payload Inventory names @(_BppMissingPayloadFile->'%(PayloadPath)', ', '), which this build did not produce in $(TargetDir)."
    />
    <CallTarget Targets="ValidatePayloadAssemblyVersions" />
    <Copy
      SourceFiles="@(BppPayloadFile)"
      DestinationFiles="@(BppPayloadFile->'$(BppPayloadStagingRoot)/%(PayloadPath)')"
    />
  </Target>
</Project>
