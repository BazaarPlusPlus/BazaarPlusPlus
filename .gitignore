# Shared by every project. A project's own .gitignore holds only the outputs
# that project generates.

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
.vs/
.fleet/
.zed/
.trae/
*.iml
*.user
*.suo
*.swp
*.swo
*~

# Agent tooling (the shared .claude/settings.json is tracked)
.claude/*
!.claude/settings.json
.agents/
.superpowers/
.gstack/
.worktrees/

# Dependencies and tool caches
node_modules/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.wrangler/
*.tsbuildinfo
*.log

# Build and coverage output
bin/
obj/
# The Android release outputs (release/android-release.mjs androidPaths)
/target/
/artifacts/
dist/
coverage/
.coverage
.coverage.*
*.egg-info/

# Secrets and machine-local config
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
signing-secrets/
.bpp-local.json
