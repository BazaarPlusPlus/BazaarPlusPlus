# Shared by every project. A project's own .gitignore holds only the outputs
# that project generates.

# Operating system files
.DS_Store
Thumbs.db

# Editor settings and temporary files
.idea/
.vscode/
.vs/
.fleet/
.zed/
.trae/
*.iml
*.user
*.suo
*.swp
*.swo
*~

# Local worktrees
.worktrees/

# Installed dependencies
node_modules/
.venv/

# Language and tool caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.wrangler/
*.tsbuildinfo

# Build and packaging output
bin/
obj/
# The Android release outputs (release/android-release.mjs androidPaths)
/target/
dist/
*.egg-info/

# Reports, logs, and verification artifacts
/artifacts/
coverage/
.coverage
.coverage.*
*.log

# Secrets and machine-local config
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
signing-secrets/
.bpp-local.json
