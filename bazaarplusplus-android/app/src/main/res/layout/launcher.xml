<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher in one column (design/components/Launcher): narrow windows and accessibility text
     sizes. LauncherActivity sets the page padding from the system bar insets. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

  <LinearLayout
      android:id="@+id/page"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">

    <include layout="@layout/launcher_app_bar" />

    <include android:id="@+id/update_banner" layout="@layout/launcher_banner" />

    <include android:id="@+id/error_banner" layout="@layout/launcher_banner" />

    <include layout="@layout/launcher_card" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/bpp_space_16" />

    <include layout="@layout/launcher_actions" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="@dimen/bpp_space_16" />

    <include layout="@layout/launcher_info" />

    <include layout="@layout/launcher_footer" />
  </LinearLayout>
</ScrollView>
