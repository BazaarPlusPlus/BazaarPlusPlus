<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/bpp_space_24">

  <!-- Two views so the mark keeps its own size while the title follows the type scale. -->
  <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      tools:ignore="UseCompoundDrawables">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no"
        android:src="@drawable/bpp_mark" />

    <TextView
        style="@style/Bpp.Text.Display"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/bpp_space_12"
        android:text="@string/app_name" />
  </LinearLayout>

  <TextView
      android:id="@+id/version"
      style="@style/Bpp.Text.Caption"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/bpp_space_4" />

  <TextView
      android:id="@+id/status"
      style="@style/Bpp.Text.Body"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="@dimen/bpp_space_24"
      android:layout_marginBottom="@dimen/bpp_space_24"
      android:gravity="center" />

  <Button
      android:id="@+id/bpp_launch"
      style="@style/Bpp.Button.Primary"
      android:layout_width="280dp"
      android:text="@string/bpp_launch" />

  <Button
      android:id="@+id/native_launch"
      style="@style/Bpp.Button.Secondary"
      android:layout_width="280dp"
      android:layout_marginTop="@dimen/bpp_space_12"
      android:text="@string/native_launch" />
</LinearLayout>
