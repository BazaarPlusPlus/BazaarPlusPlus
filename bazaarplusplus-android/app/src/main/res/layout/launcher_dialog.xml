<?xml version="1.0" encoding="utf-8"?>
<!-- The launcher's dialogs (the App update reminder, About): the brand mark, a title, one
     sentence, then a text button and a primary pill at the end. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:divider="@drawable/bpp_gap_16"
    android:orientation="vertical"
    android:paddingStart="@dimen/bpp_space_24"
    android:paddingTop="@dimen/bpp_space_24"
    android:paddingEnd="@dimen/bpp_space_24"
    android:paddingBottom="@dimen/bpp_space_16"
    android:showDividers="middle">

  <ImageView
      android:layout_width="@dimen/bpp_tile"
      android:layout_height="@dimen/bpp_tile"
      android:importantForAccessibility="no"
      android:src="@drawable/bpp_mark" />

  <TextView
      android:id="@+id/dialog_title"
      style="@style/Bpp.Text.Title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:accessibilityHeading="true" />

  <TextView
      android:id="@+id/dialog_message"
      style="@style/Bpp.Text.Body"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:textColor="@color/bpp_text_2" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:divider="@drawable/bpp_gap_8"
      android:gravity="end"
      android:orientation="horizontal"
      android:showDividers="middle">

    <Button
        android:id="@+id/dialog_dismiss"
        style="@style/Bpp.Button.Ghost.Dialog"
        android:layout_width="wrap_content" />

    <Button
        android:id="@+id/dialog_confirm"
        style="@style/Bpp.Button.Primary.Dialog"
        android:layout_width="wrap_content" />
  </LinearLayout>
</LinearLayout>
