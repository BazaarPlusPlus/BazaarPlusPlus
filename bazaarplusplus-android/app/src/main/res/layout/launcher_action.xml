<?xml version="1.0" encoding="utf-8"?>
<!-- The bottom of the panel: download progress, then the one primary action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/action"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:divider="@drawable/bpp_gap_8"
    android:orientation="vertical"
    android:showDividers="middle">

  <ProgressBar
      android:id="@+id/progress"
      style="@android:style/Widget.ProgressBar.Horizontal"
      android:layout_width="match_parent"
      android:layout_height="@dimen/bpp_progress_height"
      android:max="100"
      android:progressDrawable="@drawable/bpp_progress"
      android:visibility="gone" />

  <TextView
      android:id="@+id/progress_meta"
      style="@style/Bpp.Text.Caption"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:fontFeatureSettings="tnum"
      android:visibility="gone" />

  <Button
      android:id="@+id/primary"
      style="@style/Bpp.Button.Primary"
      android:layout_width="match_parent"
      android:visibility="gone" />
</LinearLayout>
