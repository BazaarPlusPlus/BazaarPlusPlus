<?xml version="1.0" encoding="utf-8"?>
<!-- Download progress: an accent fill on a bg-hover track, r-pill. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:id="@android:id/background">
    <shape>
      <corners android:radius="@dimen/bpp_r_pill" />
      <solid android:color="@color/bpp_bg_hover" />
    </shape>
  </item>
  <item android:id="@android:id/progress">
    <clip>
      <shape>
        <corners android:radius="@dimen/bpp_r_pill" />
        <solid android:color="@color/bpp_accent" />
      </shape>
    </clip>
  </item>
</layer-list>
