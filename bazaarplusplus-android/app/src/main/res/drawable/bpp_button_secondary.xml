<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary: bg-panel with a 1px line-strong border, bg-hover while pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape>
      <corners android:radius="@dimen/bpp_r_control" />
      <solid android:color="@color/bpp_bg_hover" />
      <stroke android:width="1dp" android:color="@color/bpp_line_strong" />
    </shape>
  </item>
  <item>
    <shape>
      <corners android:radius="@dimen/bpp_r_control" />
      <solid android:color="@color/bpp_bg_panel" />
      <stroke android:width="1dp" android:color="@color/bpp_line_strong" />
    </shape>
  </item>
</selector>
