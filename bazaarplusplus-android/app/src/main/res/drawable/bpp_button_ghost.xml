<?xml version="1.0" encoding="utf-8"?>
<!-- Ghost: no box until pressed, then bg-hover. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:state_pressed="true">
    <shape><corners android:radius="@dimen/bpp_r_pill" /><solid android:color="@color/bpp_bg_hover" /></shape>
  </item>
  <item>
    <shape><corners android:radius="@dimen/bpp_r_pill" /><solid android:color="@android:color/transparent" /></shape>
  </item>
</selector>
