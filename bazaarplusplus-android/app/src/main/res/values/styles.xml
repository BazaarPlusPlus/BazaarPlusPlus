<?xml version="1.0" encoding="utf-8"?>
<!-- The App's views over the design system (design/README.md, Apps; design/components/Launcher):
     colours, scales and type sizes come from the generated bpp_tokens.xml. -->
<resources>
  <style name="Theme.Bpp" parent="@android:style/Theme.DeviceDefault.NoActionBar">
    <item name="android:windowBackground">@color/bpp_bg_canvas</item>
    <item name="android:statusBarColor">@android:color/transparent</item>
    <item name="android:navigationBarColor">@android:color/transparent</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowLightNavigationBar">false</item>
    <item name="android:textColor">@color/bpp_text_1</item>
    <item name="android:textColorPrimary">@color/bpp_text_1</item>
    <item name="android:textColorSecondary">@color/bpp_text_2</item>
    <item name="android:colorAccent">@color/bpp_accent</item>
  </style>

  <!-- Type: tokens.json's styles; weight 600 is textFontWeight, 500 sans-serif-medium. -->
  <style name="Bpp.Text" parent="">
    <item name="android:textColor">@color/bpp_text_1</item>
    <item name="android:includeFontPadding">false</item>
  </style>
  <style name="Bpp.Text.Title">
    <item name="android:textSize">@dimen/bpp_type_title</item>
    <item name="android:textFontWeight">600</item>
    <item name="android:lineSpacingMultiplier">1.15</item>
  </style>
  <style name="Bpp.Text.BodyStrong">
    <item name="android:textSize">@dimen/bpp_type_body_strong</item>
    <item name="android:textFontWeight">600</item>
  </style>
  <style name="Bpp.Text.Body">
    <item name="android:textSize">@dimen/bpp_type_body</item>
    <item name="android:lineSpacingMultiplier">1.2</item>
  </style>
  <style name="Bpp.Text.Small">
    <item name="android:textSize">@dimen/bpp_type_small</item>
    <item name="android:fontFamily">sans-serif-medium</item>
  </style>
  <style name="Bpp.Text.Caption">
    <item name="android:textSize">@dimen/bpp_type_caption</item>
    <item name="android:textColor">@color/bpp_text_2</item>
    <item name="android:lineSpacingMultiplier">1.15</item>
  </style>
  <!-- Keys in key-value rows are text-3. -->
  <style name="Bpp.Text.Key">
    <item name="android:textSize">@dimen/bpp_type_body</item>
    <item name="android:textColor">@color/bpp_text_3</item>
  </style>
  <style name="Bpp.Text.Value">
    <item name="android:textSize">@dimen/bpp_type_body</item>
    <item name="android:fontFeatureSettings">tnum</item>
  </style>

  <!-- Button (design/components/Button): full-width launcher actions are touch-target tall. -->
  <style name="Bpp.Button" parent="">
    <item name="android:layout_height">wrap_content</item>
    <item name="android:minHeight">@dimen/bpp_touch_target</item>
    <item name="android:paddingStart">@dimen/bpp_space_12</item>
    <item name="android:paddingEnd">@dimen/bpp_space_12</item>
    <item name="android:textSize">@dimen/bpp_type_body_medium</item>
    <item name="android:textAllCaps">false</item>
    <item name="android:stateListAnimator">@null</item>
    <item name="android:fontFamily">sans-serif-medium</item>
  </style>
  <style name="Bpp.Button.Primary">
    <item name="android:background">@drawable/bpp_button_primary</item>
    <item name="android:textColor">@color/bpp_button_primary_text</item>
    <item name="android:fontFamily">@null</item>
    <item name="android:textFontWeight">600</item>
  </style>
  <style name="Bpp.Button.Secondary">
    <item name="android:background">@drawable/bpp_button_secondary</item>
    <item name="android:textColor">@color/bpp_button_secondary_text</item>
  </style>
  <!-- sm: a control-sm box with small text inside a touch-target hit area, for banner actions. -->
  <style name="Bpp.Button.Secondary.Small">
    <item name="android:background">@drawable/bpp_button_secondary_inset</item>
    <item name="android:paddingStart">@dimen/bpp_space_8</item>
    <item name="android:paddingEnd">@dimen/bpp_space_8</item>
    <item name="android:textSize">@dimen/bpp_type_small</item>
  </style>
  <!-- Key-value row: at least row-height, content centred, 16 inset. -->
  <style name="Bpp.Row" parent="">
    <item name="android:layout_width">match_parent</item>
    <item name="android:layout_height">wrap_content</item>
    <item name="android:minHeight">@dimen/bpp_row_height</item>
    <item name="android:gravity">center_vertical</item>
    <item name="android:orientation">horizontal</item>
    <item name="android:paddingStart">@dimen/bpp_space_16</item>
    <item name="android:paddingEnd">@dimen/bpp_space_16</item>
  </style>
  <style name="Bpp.Button.Ghost">
    <item name="android:background">@drawable/bpp_button_ghost</item>
    <item name="android:textColor">@color/bpp_button_ghost_text</item>
  </style>
</resources>
