diff --git a/mono/utils/bpp-apple-jit.h b/mono/utils/bpp-apple-jit.h
new file mode 100644
index 00000000..7028fa3c
--- /dev/null
+++ b/mono/utils/bpp-apple-jit.h
@@ -0,0 +1,13 @@
+// BazaarPlusPlus: arm64 simulator and macOS AOT-host processes enforce W^X, so runtime
+// trampolines need MAP_JIT and pthread_jit_write_protect_np. Real devices get no JIT at all.
+#ifndef BPP_APPLE_JIT_H
+#define BPP_APPLE_JIT_H
+#include <TargetConditionals.h>
+#if (TARGET_OS_SIMULATOR || TARGET_OS_OSX) && defined(__aarch64__)
+#define BPP_APPLE_JIT 1
+#include <pthread.h>
+extern void pthread_jit_write_protect_np(int enabled);
+#else
+#define BPP_APPLE_JIT 0
+#endif
+#endif
