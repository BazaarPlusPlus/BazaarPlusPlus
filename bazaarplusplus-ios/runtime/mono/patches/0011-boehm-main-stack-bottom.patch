diff --git a/mono/metadata/boehm-gc.c b/mono/metadata/boehm-gc.c
index 603afcf..a659afb 100644
--- a/mono/metadata/boehm-gc.c
+++ b/mono/metadata/boehm-gc.c
@@ -64,6 +64,12 @@ static gboolean gc_strict_wbarriers = FALSE;
 
 static mono_mutex_t mono_gc_lock;
 
+#ifdef HOST_DARWIN
+// ios-unity-runner: the build defines _XOPEN_SOURCE, which hides this declaration from <pthread.h>. Without it
+// bdwgc's GC_get_main_stack_base compiles the call as returning int and cuts the stack address to 32 bits.
+extern void *pthread_get_stackaddr_np (pthread_t);
+#endif
+
 static GC_push_other_roots_proc default_push_other_roots;
 static MonoGCCallbacks gc_callbacks;
 static GHashTable *roots;
@@ -230,6 +236,14 @@ mono_gc_base_init (void)
 	/* cache value rather than calling during collection since g_hasenv may take locks and can deadlock */
 	gc_dont_gc_env = g_hasenv ("GC_DONT_GC");
 
+#ifdef HOST_DARWIN
+	// ios-unity-runner: a truncated GC_stackbottom puts the initial thread's stack top below its stack pointer, so
+	// Boehm scanned none of that stack and collected objects that only native or AOT frames there referenced.
+#pragma clang diagnostic push
+#pragma clang diagnostic ignored "-Wdeprecated-declarations"
+	GC_stackbottom = (char *)pthread_get_stackaddr_np (pthread_self ());
+#pragma clang diagnostic pop
+#endif
 	GC_init ();
 
 	GC_set_warn_proc (mono_gc_warning);
