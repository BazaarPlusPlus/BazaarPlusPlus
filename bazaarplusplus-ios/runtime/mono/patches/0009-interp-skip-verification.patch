 #define INLINE_DEPTH_LIMIT 10
 
 static MonoMethod* interp_method_redirect (MonoMethod *method);
+
+/*
+ * The JIT's visibility rule (mini_assembly_can_skip_verification, which the interpreter-only runtime
+ * does not link): a method skips visibility checks when it asks to, or its assembly carries
+ * SkipVerification, which /unsafe compilers emit. Code that runs under the JIT on the desktop must
+ * also run here.
+ */
+static gboolean
+interp_skips_visibility (MonoMethod *method)
+{
+	if (method->skip_visibility)
+		return TRUE;
+	MonoAssembly *assembly = m_class_get_image (method->klass)->assembly;
+	if (method->wrapper_type != MONO_WRAPPER_NONE && method->wrapper_type != MONO_WRAPPER_DYNAMIC_METHOD)
+		return FALSE;
+	if (assembly->in_gac || assembly->image == mono_defaults.corlib)
+		return FALSE;
+	return mono_assembly_has_skip_verification (assembly);
+}
 static void interp_record_inline (MonoMethod *root, MonoMethod *inlined);
 
