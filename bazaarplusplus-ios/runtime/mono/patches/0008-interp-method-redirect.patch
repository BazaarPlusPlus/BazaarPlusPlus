 static mono_mutex_t calc_section;
 
+/*
+ * Method redirects. Calls to a redirected method run its target, a method with the same arguments
+ * (`this` first for instance methods): method_entry swaps the frame to the target, so everything the
+ * target's code reads from its frame is its own. Harmony patches use this in place of native detours,
+ * which need writable code. Callers that inlined a method keep a copy of its old body, so every root
+ * method that inlined a candidate is indexed and re-transformed on redirect. Guarded by calc_section.
+ */
+static GHashTable *method_redirects;   /* MonoMethod* -> MonoMethod* */
+static GHashTable *inline_roots;       /* inlined MonoMethod* -> GPtrArray of root MonoMethod* */
+
+static MonoMethod*
+interp_method_redirect (MonoMethod *method)
+{
+	MonoMethod *target = NULL;
+	mono_os_mutex_lock (&calc_section);
+	if (method_redirects)
+		target = (MonoMethod*)g_hash_table_lookup (method_redirects, method);
+	mono_os_mutex_unlock (&calc_section);
+	return target;
+}
+
+static void
+interp_record_inline (MonoMethod *root, MonoMethod *inlined)
+{
+	if (m_class_get_image (inlined->klass) == mono_defaults.corlib)
+		return;
+	mono_os_mutex_lock (&calc_section);
+	if (!inline_roots)
+		inline_roots = g_hash_table_new (NULL, NULL);
+	GPtrArray *roots = (GPtrArray*)g_hash_table_lookup (inline_roots, inlined);
+	if (!roots) {
+		roots = g_ptr_array_new ();
+		g_hash_table_insert (inline_roots, inlined, roots);
+	}
+	guint i;
+	for (i = 0; i < roots->len && g_ptr_array_index (roots, i) != root; ++i)
+		;
+	if (i == roots->len)
+		g_ptr_array_add (roots, root);
+	mono_os_mutex_unlock (&calc_section);
+}
+
+static void
+interp_invalidate_method (MonoDomain *domain, MonoMethod *method)
+{
+	MonoJitDomainInfo *info = domain_jit_info (domain);
+	mono_domain_jit_code_hash_lock (domain);
+	InterpMethod *imethod = (InterpMethod*)mono_internal_hash_table_lookup (&info->interp_code_hash, method);
+	mono_domain_jit_code_hash_unlock (domain);
+	if (imethod)
+		imethod->transformed = FALSE;
+}
+
+/* Redirects ORIGINAL to TARGET; a NULL TARGET restores ORIGINAL. Frames already running keep their code. */
+MONO_API void
+mono_interp_redirect_method (MonoMethod *original, MonoMethod *target)
+{
+	ERROR_DECL (error);
+	MonoDomain *domain = mono_domain_get ();
+	InterpMethod *imethod = mono_interp_get_imethod (domain, original, error);
+	InterpMethod *redirect = target ? mono_interp_get_imethod (domain, target, error) : NULL;
+	if (!is_ok (error)) {
+		mono_error_cleanup (error);
+		return;
+	}
+	mono_os_mutex_lock (&calc_section);
+	if (!method_redirects)
+		method_redirects = g_hash_table_new (NULL, NULL);
+	if (target)
+		g_hash_table_insert (method_redirects, original, target);
+	else
+		g_hash_table_remove (method_redirects, original);
+	imethod->redirect = redirect;
+	mono_memory_barrier ();
+	/* Untransformed, so the next call takes method_entry's slow path, which follows the redirect. */
+	imethod->transformed = FALSE;
+	GPtrArray *roots = inline_roots ? (GPtrArray*)g_hash_table_lookup (inline_roots, original) : NULL;
+	for (guint i = 0; roots && i < roots->len; ++i)
+		interp_invalidate_method (domain, (MonoMethod*)g_ptr_array_index (roots, i));
+	mono_os_mutex_unlock (&calc_section);
+}
