+			NULL_CHECK (o);
+			/* String.GetLegacyNonRandomizedHashCode, bit for bit: two interleaved hashes over the chars, up to
+			 * the first NUL. Unsigned arithmetic gives C#'s unchecked int wraparound. */
+			const gunichar2 *p = mono_string_chars_internal ((MonoString*) o);
+			guint32 h1 = 5381, h2 = 5381, c;
+			while ((c = p [0]) != 0) {
