+					break;
+				h2 = ((h2 << 5) + h2) ^ c;
+				p += 2;
+			}
+			LOCAL_VAR (ip [1], gint32) = (gint32)(h1 + h2 * 1566083941u);
+			ip += 3;
+			MINT_IN_BREAK;
+		}
