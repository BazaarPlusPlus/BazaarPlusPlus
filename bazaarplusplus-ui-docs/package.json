{
  "name": "bazaarplusplus-ui-docs",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vp dev --host 0.0.0.0 --port 4176 --strictPort",
    "build": "vp build",
    "preview": "bun run build && bun run preview:built",
    "preview:built": "vp preview --host 0.0.0.0 --port 4176 --strictPort",
    "test": "vp test run",
    "test:watch": "vp test",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint --type-aware",
    "lint:fix": "vp lint --type-aware --fix",
    "format": "vp fmt .",
    "format:check": "vp fmt --check ."
  },
  "dependencies": {
    "@bazaarplusplus/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@bpp/runs": "workspace:*",
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@8.3.8000",
    "wrangler": "^4.164.0",
    "vite-plus": "1.7.0"
  },
  "engines": {
    "bun": "1.4.4"
  },
  "packageManager": "bun@1.4.4"
}
