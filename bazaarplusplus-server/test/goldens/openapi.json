{
  "openapi": "3.1.0",
  "info": {
    "title": "BazaarPlusPlus Mod API V6",
    "version": "6",
    "description": "The mod-facing backend for Bundle V6. Errors share one envelope; clients act on the status, `code`, and `retryable`, never on `message`. A known path with another method returns `405 method_not_allowed` with `Allow`, and an unknown path returns `404 not_found`. No route sends CORS headers."
  },
  "servers": [
    {
      "url": "https://mod-api-v6.bazaarplusplus.com"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Liveness"
    },
    {
      "name": "Ingest",
      "description": "Public Bundle upload"
    },
    {
      "name": "Discovery",
      "description": "Bundle and Ghost Battle discovery"
    },
    {
      "name": "Documentation",
      "description": "This document and its reference page"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness probe",
        "description": "Touches no D1, R2, secret, limiter, or presigner.",
        "responses": {
          "200": {
            "description": "Alive",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "- `internal_error` (retryable): Unclassified server error or invalid service configuration",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/bundles": {
      "get": {
        "tags": [
          "Discovery"
        ],
        "summary": "Enumerate Bundles for the analyzer",
        "description": "Keyset pages over a fixed, stateless availability window. Parameters may appear only once and unknown parameters are invalid. The Worker signs only returned rows.",
        "security": [
          {
            "BundleSyncToken": []
          }
        ],
        "parameters": [
          {
            "in": "query",
            "name": "available_from_ms",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Inclusive window start; no earlier than server time minus 8 days"
            },
            "required": true,
            "description": "Inclusive window start; no earlier than server time minus 8 days"
          },
          {
            "in": "query",
            "name": "available_before_ms",
            "schema": {
              "description": "Exclusive window end; defaults to and may not exceed `server_now_ms - 60000`",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "description": "Exclusive window end; defaults to and may not exceed `server_now_ms - 60000`"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 200,
              "type": "integer",
              "minimum": 1,
              "maximum": 500
            }
          },
          {
            "in": "query",
            "name": "after_available_at_ms",
            "schema": {
              "description": "Keyset cursor, paired with `after_bundle_id`: the last returned availability time",
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "description": "Keyset cursor, paired with `after_bundle_id`: the last returned availability time"
          },
          {
            "in": "query",
            "name": "after_bundle_id",
            "schema": {
              "description": "Keyset cursor, paired with `after_available_at_ms`: the last returned Bundle ID",
              "type": "string",
              "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$",
              "example": "01J00000000000000000000001"
            },
            "description": "Keyset cursor, paired with `after_available_at_ms`: the last returned Bundle ID"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of the window",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BundleCollectionPage"
                }
              }
            }
          },
          "400": {
            "description": "- `invalid_query`: Missing, repeated, unknown, or invalid query parameter\n- `window_not_settled`: Bundle window ends after the settle point",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "- `unauthorized`: Missing or invalid service token",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "- `insufficient_scope`: Service token does not grant access to the route",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "410": {
            "description": "- `window_expired`: Bundle window is outside R2 retention",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "- `internal_error` (retryable): Unclassified server error or invalid service configuration",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "- `storage_unavailable` (retryable): Storage, signing, or rate limiter unavailable",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Ingest"
        ],
        "summary": "Upload one sealed Bundle",
        "description": "Public and unauthenticated: `run.player_account_id` is a caller assertion. The body is the Bundle V6 binary (prefix, manifest, Run, optional Screenshot), streamed into R2 while length and digests are validated. Stable `invalid_bundle.details.reason` values are listed in `docs/api-reference.md`.",
        "parameters": [
          {
            "in": "header",
            "name": "Content-Length",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 8388607,
              "description": "Exact Bundle byte length"
            },
            "required": true,
            "description": "Exact Bundle byte length"
          },
          {
            "in": "header",
            "name": "Content-Digest",
            "schema": {
              "type": "string",
              "description": "Exactly one RFC 9530 value: `sha-256=:<base64 SHA-256>:`"
            },
            "required": true,
            "description": "Exactly one RFC 9530 value: `sha-256=:<base64 SHA-256>:`"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/x-bpp-bundle-v6": {
              "schema": {
                "type": "string",
                "description": "Bundle V6 binary, 1–8388607 bytes",
                "contentMediaType": "application/x-bpp-bundle-v6"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Identical Bundle already stored",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BundleReceipt"
                }
              }
            }
          },
          "201": {
            "description": "First logical commit",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BundleReceipt"
                }
              }
            }
          },
          "400": {
            "description": "- `invalid_content_length`: Invalid header or actual length mismatch\n- `invalid_content_digest`: Invalid or unsupported digest field",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "- `bundle_id_conflict`: Bundle identity has different bytes\n- `run_already_bundled`: Run belongs to another Bundle",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "411": {
            "description": "- `content_length_required`: Content-Length header missing",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "413": {
            "description": "- `bundle_too_large`: Declared or actual size reaches 8 MiB",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "415": {
            "description": "- `unsupported_content_type`: Wrong Bundle media type",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "- `invalid_bundle`: Prefix, manifest, layout, or bounds invalid\n- `unsupported_bundle_version`: Bundle version not accepted\n- `unsupported_run_format`: Run format not accepted\n- `bundle_digest_mismatch`: Complete digest mismatch\n- `segment_digest_mismatch`: Run or Screenshot digest mismatch",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "- `internal_error` (retryable): Unclassified server error or invalid service configuration",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "- `storage_unavailable` (retryable): Storage, signing, or rate limiter unavailable",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/ghost-battles": {
      "get": {
        "tags": [
          "Discovery"
        ],
        "summary": "Discover Ghost Battles against a player",
        "description": "Per-IP rate limited before parsing. Looks back exactly five days. An unknown account returns an empty list.",
        "parameters": [
          {
            "in": "query",
            "name": "player_account_id",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
              "description": "The local player whose Ghosts to find"
            },
            "required": true,
            "description": "The local player whose Ghosts to find"
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 200,
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Ghost Battle summaries",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GhostDiscoveryResponse"
                }
              }
            }
          },
          "400": {
            "description": "- `invalid_query`: Missing, repeated, unknown, or invalid query parameter",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "429": {
            "description": "- `rate_limited` (retryable): Ghost request rate exceeded",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              },
              "Retry-After": {
                "description": "Seconds to wait",
                "schema": {
                  "const": "60"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "- `internal_error` (retryable): Unclassified server error or invalid service configuration",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "- `storage_unavailable` (retryable): Storage, signing, or rate limiter unavailable",
            "headers": {
              "X-Request-Id": {
                "description": "CF-Ray, or a server UUID",
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorResponse"
                }
              }
            }
          }
        }
      }
    },
