{
  "name": "bazaarplusplus-server-v5",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && biome check .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "0.45.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "@cloudflare/vitest-pool-workers": "0.20.1",
    "@cloudflare/workers-types": "5.20260801.1",
    "@types/node": "^25.5.0",
    "typescript": "^5.8.3",
    "vitest": "^4.1.4",
    "wrangler": "4.118.0"
  }
}
