{
  "name": "bazaarplusplus-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json && biome check .",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "zod": "4.6.7",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@cfworker/json-schema": "4.1.3",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261030.1",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "miniflare": {
      "undici": "7.30.1"
    },
    "@cloudflare/vitest-pool-workers": {
      "zod": "4.6.7"
    }
  },
  "packageManager": "bun@1.4.4"
}
