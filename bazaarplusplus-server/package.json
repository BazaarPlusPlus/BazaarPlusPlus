{
  "name": "bazaarplusplus-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "bun": "1.4.4"
  },
  "scripts": {
    "check": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.json && oxlint --type-aware && oxfmt --check .",
    "lint": "oxlint --type-aware",
    "format": "oxfmt .",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "aws4fetch": "^1.0.20",
    "zod": "4.6.7",
    "zod-openapi": "6.0.2"
  },
  "devDependencies": {
    "@cfworker/json-schema": "4.1.4",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "@cloudflare/workers-types": "5.20261031.1",
    "@types/node": "^26.6.6",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "4.156.0"
  },
  "overrides": {
    "sharp": "0.35.5",
    "miniflare": {
      "undici": "7.30.1"
    },
    "@cloudflare/vitest-pool-workers": {
      "zod": "4.6.7"
    }
  },
  "packageManager": "bun@1.4.4"
}
