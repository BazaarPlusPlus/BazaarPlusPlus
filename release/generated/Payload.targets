<Project>
  <!-- Generated from release/payload.json by node release.mjs sync. -->
  <Target Name="ValidatePayloadInventoryProjection" BeforeTargets="PrepareForBuild;CollectPayloadFiles">
    <GetFileHash Files="$(MSBuildThisFileDirectory)../payload.json" Algorithm="SHA256"><Output TaskParameter="Items" ItemName="_PayloadInventoryHash" /></GetFileHash>
    <Error Condition="'%(_PayloadInventoryHash.FileHash)' != '932B7D9F764768B1C6A71B19477B191939E94F5CAA891CA0AED29A9DC535AEF3'" Text="Payload Inventory projection is stale. Run node release.mjs sync." />
  </Target>
  <Target Name="CollectPayloadFiles" DependsOnTargets="ValidatePayloadInventoryProjection">
    <PropertyGroup>
      <BppPayloadHost Condition="'$(BppPayloadHost)' == ''">bepinex</BppPayloadHost>
      <BppPayloadPlatform Condition="'$(BppReleasePlatform)' != ''">$(BppReleasePlatform)</BppPayloadPlatform>
      <BppPayloadPlatform Condition="'$(BppPayloadPlatform)' == '' and '$(BppPayloadHost)' == 'melonloader'">android</BppPayloadPlatform>
      <BppPayloadPlatform Condition="'$(BppPayloadPlatform)' == '' and '$(IsMacHost)' == 'true'">macos</BppPayloadPlatform>
      <BppPayloadPlatform Condition="'$(BppPayloadPlatform)' == '' and '$(IsWindowsHost)' == 'true'">windows</BppPayloadPlatform>
    </PropertyGroup>
    <ItemGroup Condition="'$(BppPayloadHost)' == 'bepinex'">
      <BppPayloadFile Include="$(TargetDir)BazaarPlusPlus.dll"><PayloadPath>BepInEx/plugins/BazaarPlusPlus.dll</PayloadPath><ProductAssembly>true</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)BazaarPlusPlus.Core.dll"><PayloadPath>BepInEx/plugins/BazaarPlusPlus.Core.dll</PayloadPath><ProductAssembly>true</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)BazaarPlusPlus.ModApi.dll"><PayloadPath>BepInEx/plugins/BazaarPlusPlus.ModApi.dll</PayloadPath><ProductAssembly>true</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)BazaarPlusPlus.Storage.dll"><PayloadPath>BepInEx/plugins/BazaarPlusPlus.Storage.dll</PayloadPath><ProductAssembly>true</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)BazaarPlusPlus.version"><PayloadPath>BepInEx/plugins/BazaarPlusPlus.version</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(HistoryDatabaseContractFile)"><PayloadPath>BepInEx/plugins/BazaarPlusPlus.history-database.json</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(BppUpdaterFile)"><PayloadPath>BepInEx/patchers/BazaarPlusPlus.Updater.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)Microsoft.Data.Sqlite.dll"><PayloadPath>BepInEx/plugins/Microsoft.Data.Sqlite.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)SQLitePCLRaw.batteries_v2.dll"><PayloadPath>BepInEx/plugins/SQLitePCLRaw.batteries_v2.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)SQLitePCLRaw.core.dll"><PayloadPath>BepInEx/plugins/SQLitePCLRaw.core.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)SQLitePCLRaw.provider.e_sqlite3.dll"><PayloadPath>BepInEx/plugins/SQLitePCLRaw.provider.e_sqlite3.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)SixLabors.ImageSharp.dll" Condition="Exists('$(TargetDir)SixLabors.ImageSharp.dll')"><PayloadPath>BepInEx/plugins/SixLabors.ImageSharp.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)System.Buffers.dll" Condition="Exists('$(TargetDir)System.Buffers.dll')"><PayloadPath>BepInEx/plugins/System.Buffers.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)System.Memory.dll" Condition="Exists('$(TargetDir)System.Memory.dll')"><PayloadPath>BepInEx/plugins/System.Memory.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)System.Numerics.Vectors.dll" Condition="Exists('$(TargetDir)System.Numerics.Vectors.dll')"><PayloadPath>BepInEx/plugins/System.Numerics.Vectors.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)System.Text.Encoding.CodePages.dll" Condition="Exists('$(TargetDir)System.Text.Encoding.CodePages.dll')"><PayloadPath>BepInEx/plugins/System.Text.Encoding.CodePages.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(FixedMacSqliteNativeFile)" Condition="'$(BppPayloadPlatform)' == 'macos'"><PayloadPath>BepInEx/plugins/libe_sqlite3.dylib</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(FixedWindowsSqliteNativeFile)" Condition="'$(BppPayloadPlatform)' == 'windows'"><PayloadPath>BepInEx/plugins/e_sqlite3.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
    </ItemGroup>
    <ItemGroup Condition="'$(BppPayloadHost)' == 'melonloader'">
      <BppPayloadFile Include="$(TargetDir)BazaarPlusPlus.Android.dll"><PayloadPath>MelonLoader/Mods/BazaarPlusPlus.Android.dll</PayloadPath><ProductAssembly>true</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)BazaarPlusPlus.Core.dll"><PayloadPath>MelonLoader/Mods/BazaarPlusPlus.Core.dll</PayloadPath><ProductAssembly>true</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)BazaarPlusPlus.ModApi.dll"><PayloadPath>MelonLoader/Mods/BazaarPlusPlus.ModApi.dll</PayloadPath><ProductAssembly>true</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)BazaarPlusPlus.Storage.dll"><PayloadPath>MelonLoader/Mods/BazaarPlusPlus.Storage.dll</PayloadPath><ProductAssembly>true</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)BazaarPlusPlus.version"><PayloadPath>MelonLoader/Mods/BazaarPlusPlus.version</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(HistoryDatabaseContractFile)"><PayloadPath>MelonLoader/Mods/BazaarPlusPlus.history-database.json</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(BppUpdaterFile)"><PayloadPath>MelonLoader/Plugins/BazaarPlusPlus.Updater.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)Microsoft.Data.Sqlite.dll"><PayloadPath>MelonLoader/UserLibs/Microsoft.Data.Sqlite.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)SQLitePCLRaw.batteries_v2.dll"><PayloadPath>MelonLoader/UserLibs/SQLitePCLRaw.batteries_v2.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)SQLitePCLRaw.core.dll"><PayloadPath>MelonLoader/UserLibs/SQLitePCLRaw.core.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)SQLitePCLRaw.provider.e_sqlite3.dll"><PayloadPath>MelonLoader/UserLibs/SQLitePCLRaw.provider.e_sqlite3.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)MessagePack.dll"><PayloadPath>MelonLoader/UserLibs/MessagePack.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)MessagePack.Annotations.dll"><PayloadPath>MelonLoader/UserLibs/MessagePack.Annotations.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
      <BppPayloadFile Include="$(TargetDir)Newtonsoft.Json.dll"><PayloadPath>MelonLoader/UserLibs/Newtonsoft.Json.dll</PayloadPath><ProductAssembly>false</ProductAssembly></BppPayloadFile>
    </ItemGroup>
  </Target>
  <Target Name="ValidatePayloadAssemblyVersions" DependsOnTargets="CollectPayloadFiles">
    <ItemGroup><_ProductAssembly Include="@(BppPayloadFile)" Condition="'%(BppPayloadFile.ProductAssembly)' == 'true'" /></ItemGroup>
    <GetAssemblyIdentity AssemblyFiles="@(_ProductAssembly)"><Output TaskParameter="Assemblies" ItemName="_ProductAssemblyIdentity" /></GetAssemblyIdentity>
    <Error Condition="'%(_ProductAssemblyIdentity.Version)' != '$(BppVersion).0'" Text="Payload assembly %(_ProductAssemblyIdentity.Identity) has version %(_ProductAssemblyIdentity.Version); expected $(BppVersion).0." />
  </Target>
</Project>
