{
  "name": "bazaarplusplus-site",
  "compatibility_date": "2026-04-25",
  "workers_dev": false,
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
  "routes": [
    {
      "pattern": "bazaarplusplus.com",
      "custom_domain": true,
    },
    {
      "pattern": "www.bazaarplusplus.com",
      "custom_domain": true,
    },
  ],
  "env": {
    "preview": {
      "workers_dev": true,
      "routes": [],
    },
  },
}
