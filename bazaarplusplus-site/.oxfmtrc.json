{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "none",
  "printWidth": 80,
  "sortPackageJson": false,
  "ignorePatterns": [
    "dist/**",
    ".wrangler/**",
    "**/*.md",
    "e2e/__snapshots__/**",
    "test-results/**",
    "playwright-report/**"
  ]
}
