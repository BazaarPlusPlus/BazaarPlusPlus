{
  "name": "bazaarplusplus-site",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "tokens": "node -e \"require('node:fs').copyFileSync('../bazaarplusplus-installer/src/styles/tokens.css', 'src/styles/installer-tokens.css')\"",
    "predev": "npm run tokens",
    "dev": "vite --host 0.0.0.0 --port 3000 --strictPort",
    "prebuild": "npm run tokens",
    "build": "vite build",
    "deploy": "npm run build && npx wrangler deploy",
    "deploy:dry-run": "npm run build && npx wrangler deploy --dry-run",
    "deploy:preview": "npm run build && npx wrangler deploy --env preview",
    "deploy:preview:dry-run": "npm run build && npx wrangler deploy --env preview --dry-run",
    "preview": "npm run build && vite preview --host 0.0.0.0 --port 3000 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "lint:fix": "oxlint --type-aware --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "^8.20.0",
    "jsdom": "^30.1.1",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "wrangler": "^4.147.0"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
