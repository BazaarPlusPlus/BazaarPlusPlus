# Workspace projects credentials from config.toml server and cloudflare sections.
# For a hand-written .env, set BPP_BUNDLE_SYNC_TOKEN, CLOUDFLARE_ACCOUNT_ID
# and CLOUDFLARE_API_TOKEN. No source or publication target settings are needed.

# Optional machine limits and state location; omit to use application defaults.
# BPP_DATA_ROOT must be absolute when set. Default: ~/.local/share/bazaarplusplus/analyzer
# BPP_DATA_ROOT=/absolute/path/to/data
# BPP_MAX_RUN_SECONDS=21600
# BPP_DUCKDB_MEMORY_LIMIT=8GB
# BPP_DUCKDB_THREADS=8
