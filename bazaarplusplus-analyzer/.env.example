# Copy to .env and fill in the required values. Git ignores the local .env.

# Local state
BPP_DATA_ROOT=/absolute/path/to/data

# Bundle Server
BPP_API_BASE_URL=

# R2; required only for publication. The S3 pair is derived from the token.
# The V6 metrics bucket: docs/architecture.md, Publication target.
BPP_METRICS_R2_BUCKET=
# Key prefix inside that bucket; production publishes under metrics/v6.
BPP_METRICS_R2_PREFIX=

# The workspace appends BPP_BUNDLE_SYNC_TOKEN, CLOUDFLARE_API_TOKEN and
# CLOUDFLARE_ACCOUNT_ID from config.ini [server] and [cloudflare]
# (node scripts/workspace.mjs --help); a hand-written .env sets them here.

# Optional; omit to use application defaults
# BPP_SOURCE_EPOCH=YYYY-MM-DD
# BPP_BUNDLE_RETENTION_DAYS=8
# BPP_FACT_RETENTION_DAYS=8
# BPP_DOWNLOAD_CONCURRENCY=64
# BPP_DOWNLOAD_LOOKAHEAD=128
# BPP_MAX_RUN_SECONDS=21600
# BPP_DUCKDB_MEMORY_LIMIT=8GB
# BPP_DUCKDB_THREADS=8
